@page "/vehicles"
@page "/Vehicles"
@using System.ComponentModel.DataAnnotations
@using System.Net

@inject IReservationBookingService ReservationBookingService
@inject NavigationManager Navigation

<PageTitle>وضعیت خودروها</PageTitle>

<div class="vehicles-status-page" dir="rtl">
    <div class="page-header">
        <h1>وضعیت خودروها</h1>
        <p class="page-subtitle">جستجو با شماره رزرو و شماره شاسی (GetBooking)</p>
    </div>

    <div class="search-card">
        <EditForm Model="@Search" OnValidSubmit="SearchAsync">
            <DataAnnotationsValidator />
            <div class="search-grid">
                <div class="form-field">
                    <label for="bookingCode">شماره رزرو</label>
                    <InputText id="bookingCode"
                               @bind-Value="Search.BookingCode"
                               class="form-control"
                               dir="ltr"
                               maxlength="40"
                               placeholder="مثال: 1-1001-11" />
                    <ValidationMessage For="@(() => Search.BookingCode)" />
                </div>
                <div class="form-field">
                    <label for="chassisNumber">شماره شاسی</label>
                    <InputText id="chassisNumber"
                               @bind-Value="Search.ChassisNumber"
                               class="form-control"
                               dir="ltr"
                               maxlength="32"
                               placeholder="کامل یا ۸ رقم انتهایی" />
                    <ValidationMessage For="@(() => Search.ChassisNumber)" />
                </div>
                <div class="form-actions">
                    <button type="submit" class="btn btn-primary" disabled="@isSearching">
                        @(isSearching ? "در حال جستجو..." : "جستجو")
                    </button>
                </div>
            </div>
        </EditForm>
    </div>

    @if (searched)
    {
        @if (Results.Count == 0)
        {
            <div class="empty-state">
                <p>@(string.IsNullOrWhiteSpace(errorMessage) ? "نتیجه‌ای یافت نشد." : errorMessage)</p>
            </div>
        }
        else
        {
            <div class="table-responsive results-table-wrap">
                <table class="table table-striped table-hover results-table">
                    <thead>
                        <tr>
                            <th>شماره رزرو</th>
                            <th>تاریخ</th>
                            <th>ساعت</th>
                            <th>نام</th>
                            <th>وضعیت</th>
                            <th>مدل</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Results)
                        {
                            var id = item.UniqueId ?? item.BookingCode ?? Guid.NewGuid().ToString();
                            var isOpen = string.Equals(selectedId, id, StringComparison.Ordinal);
                            <tr class="@(isOpen ? "is-selected" : null)" @key="id">
                                <td dir="ltr">@Display(item.BookingCode)</td>
                                <td>@Display(item.StrBookingDate)</td>
                                <td dir="ltr">@Display(item.StrBookingTime)</td>
                                <td>@Display(SubscriberName(item))</td>
                                <td>@Display(item.BookingStatus)</td>
                                <td>@Display(VehicleModel(item))</td>
                                <td>
                                    <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => ToggleDetail(id)">
                                        @(isOpen ? "بستن" : "جزئیات")
                                    </button>
                                </td>
                            </tr>
                            @if (isOpen)
                            {
                                <tr class="detail-row" @key="@($"{id}-detail")">
                                    <td colspan="7">
                                        <dl class="detail-grid">
                                            <div>
                                                <dt>موبایل</dt>
                                                <dd dir="ltr">@Display(Mobile(item))</dd>
                                            </div>
                                            <div>
                                                <dt>شماره شاسی</dt>
                                                <dd dir="ltr">@Display(item.BookingVinNumber)</dd>
                                            </div>
                                            <div>
                                                <dt>پلاک</dt>
                                                <dd>@Display(item.BookingChassisPlate)</dd>
                                            </div>
                                            <div>
                                                <dt>نمایندگی</dt>
                                                <dd>@Display(item.DealerName)</dd>
                                            </div>
                                            <div>
                                                <dt>شعبه</dt>
                                                <dd>@Display(item.BranchName)</dd>
                                            </div>
                                            <div>
                                                <dt>مشاور تعمیر</dt>
                                                <dd>@Display(Adviser(item))</dd>
                                            </div>
                                            <div>
                                                <dt>گروه سرویس</dt>
                                                <dd>@Display(item.BookingServerGroupLocalizedName)</dd>
                                            </div>
                                            <div>
                                                <dt>تلفن شعبه</dt>
                                                <dd dir="ltr">@Display(item.BranchShopPhoneNumber)</dd>
                                            </div>
                                            <div class="full">
                                                <dt>آدرس</dt>
                                                <dd>@Display(Address(item))</dd>
                                            </div>
                                            <div class="full">
                                                <dt>توضیحات</dt>
                                                <dd class="pre-wrap">@Display(Description(item))</dd>
                                            </div>
                                            @if (item.BookingCustomerStatement is { Length: > 0 })
                                            {
                                                <div class="full">
                                                    <dt>اظهارات مشتری</dt>
                                                    <dd>
                                                        @string.Join(" / ", item.BookingCustomerStatement
                                                            .Select(s => FirstNonEmpty(s.BookingCustomerStatementDescription, s.CustomerStatementsTypeLocalizedName))
                                                            .Where(s => !string.IsNullOrWhiteSpace(s)))
                                                    </dd>
                                                </div>
                                            }
                                        </dl>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        }
    }
</div>

@code {
    private readonly SearchModel Search = new();
    private readonly List<BookingResultDto> Results = new();
    private bool isSearching;
    private bool searched;
    private string? errorMessage;
    private string? selectedId;

    private async Task SearchAsync()
    {
        isSearching = true;
        searched = false;
        errorMessage = null;
        Results.Clear();
        selectedId = null;

        var bookingCode = (Search.BookingCode ?? string.Empty).Trim();
        var chassis = (Search.ChassisNumber ?? string.Empty).Trim();

        var result = await ReservationBookingService.GetBookingAsync(bookingCode, chassis);

        if (result.StatusCode == (int)HttpStatusCode.Unauthorized)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        searched = true;

        if (result.Succeeded && result.Data is { Length: > 0 })
        {
            Results.AddRange(result.Data.Where(x => x is not null && !string.IsNullOrWhiteSpace(x.UniqueId)));
            if (Results.Count == 1)
                selectedId = Results[0].UniqueId ?? Results[0].BookingCode;
        }
        else
        {
            errorMessage = string.IsNullOrWhiteSpace(result.Message)
                ? "نوبتی با این مشخصات یافت نشد."
                : result.Message;
        }

        isSearching = false;
    }

    private void ToggleDetail(string id)
        => selectedId = string.Equals(selectedId, id, StringComparison.Ordinal) ? null : id;

    private static string SubscriberName(BookingResultDto item)
        => FirstNonEmpty(
            item.BookingSubscriberName,
            string.Join(' ', new[] { item.BookingFirstName, item.BookingLastName }.Where(s => !string.IsNullOrWhiteSpace(s))));

    private static string Mobile(BookingResultDto item)
        => item.BookingMobile?.ToString() ?? string.Empty;

    private static string VehicleModel(BookingResultDto item)
        => FirstNonEmpty(item.AbreviatedName, item.BookingVehicleTypeName, item.BookingVehicleModel);

    private static string Adviser(BookingResultDto item)
        => FirstNonEmpty(item.BookingRepairAdviser, item.PersonnelReception);

    private static string Address(BookingResultDto item)
        => FirstNonEmpty(item.BookingDealerAddress, item.BranchShopAddress);

    private static string Description(BookingResultDto item)
        => item.BookingDescription?.ToString()?.Trim() ?? string.Empty;

    private static string Display(string? value)
        => string.IsNullOrWhiteSpace(value) ? "—" : value;

    private static string FirstNonEmpty(params string?[] values)
        => values.FirstOrDefault(v => !string.IsNullOrWhiteSpace(v)) ?? string.Empty;

    private sealed class SearchModel
    {
        [Required(ErrorMessage = "شماره رزرو الزامی است.")]
        public string? BookingCode { get; set; }

        [Required(ErrorMessage = "شماره شاسی الزامی است.")]
        public string? ChassisNumber { get; set; }
    }
}
