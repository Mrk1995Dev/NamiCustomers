@page "/booking/list"
@page "/booking/MyBooking"

@using NamiCustomers.Web.Utilities

@inject IVehicleService vehicleService
@inject IBookingService bookingService
@inject NavigationManager Navigation
@inject ISnackbar snackbar

<PageTitle>لیست نوبت‌ها | نامی خودرو</PageTitle>

@if (isLoading)
{
    <div class="loader-container">
        <MudProgressCircular Rounded="true" Size="MudBlazor.Size.Medium" StrokeWidth="5" Style="color: #ffffff;" Indeterminate="true" />
    </div>
}
else
{
    <div class="book-page">
        <div class="container">
            <div class="book-top">
                @if (selectedVehicle is null)
                {
                    <span aria-hidden="true"></span>
                    <h1>لیست نوبت‌ها</h1>
                    <NavLink class="book-back" href="/booking" title="بازگشت">
                        <i class="bi bi-arrow-right"></i>
                    </NavLink>
                }
                else
                {
                    <span aria-hidden="true"></span>
                    <h1>نوبت خودرو</h1>
                    <button type="button" class="book-back" title="بازگشت به خودروها" @onclick="BackToVehicles">
                        <i class="bi bi-arrow-right"></i>
                    </button>
                }
            </div>

            @if (selectedVehicle is null)
            {
                <p class="book-lead">خودرو را انتخاب کنید تا نوبت‌های همان شاسی نمایش داده شود.</p>

                @if (vehicles.Count == 0)
                {
                    <section class="book-empty">
                        <i class="bi bi-car-front"></i>
                        <h2>خودرویی ثبت نشده است</h2>
                        <p>برای مشاهده نوبت‌ها ابتدا یک خودرو با شماره شاسی اضافه کنید.</p>
                        <NavLink class="book-empty__btn" href="/vehicle">خودروهای من</NavLink>
                    </section>
                }
                else
                {
                    <div class="book-vehicle-grid">
                        @foreach (var item in vehicles)
                        {
                            var vehicleId = item.Id ?? 0;
                            <button type="button"
                                    class="book-vehicle"
                                    @key="vehicleId"
                                    disabled="@isSelecting"
                                    @onclick="() => SelectVehicleAsync(item)">
                                <div class="book-vehicle__media">
                                    <img src="@GetVehicleImage(item)"
                                         alt="@Display(item.SelectedVehicleCommonName)"
                                         @onerror="() => OnImageError(vehicleId)" />
                                    @if (item.IsDefault)
                                    {
                                        <span class="book-vehicle__badge">پیش‌فرض</span>
                                    }
                                </div>
                                <div class="book-vehicle__body">
                                    <div class="book-vehicle__info">
                                        <h2>@Display(item.SelectedVehicleCommonName)</h2>
                                        @if (!string.IsNullOrWhiteSpace(item.VinNumber))
                                        {
                                            <p class="book-vehicle__vin">@item.VinNumber</p>
                                        }
                                        else
                                        {
                                            <p class="book-vehicle__vin is-missing">شماره شاسی ثبت نشده</p>
                                        }
                                        <ul class="book-vehicle__meta">
                                            @if (!string.IsNullOrWhiteSpace(item.ProductYear))
                                            {
                                                <li>@ToPersian(item.ProductYear)</li>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(item.BodyColor))
                                            {
                                                <li>@item.BodyColor</li>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(item.ChassisUsageTypeName))
                                            {
                                                <li>@item.ChassisUsageTypeName</li>
                                            }
                                        </ul>
                                    </div>
                                    <i class="bi bi-chevron-left book-vehicle__chevron" aria-hidden="true"></i>
                                </div>
                            </button>
                        }
                    </div>
                }
            }
            else
            {
                <section class="book-selected">
                    <div>
                        <strong>@Display(selectedVehicle.SelectedVehicleCommonName)</strong>
                        <span>@Display(selectedVehicle.VinNumber)</span>
                    </div>
                    <img src="@GetVehicleImage(selectedVehicle)"
                         alt="@Display(selectedVehicle.SelectedVehicleCommonName)"
                         @onerror="() => OnImageError(selectedVehicle.Id ?? 0)" />
                </section>

                @if (HasBooking)
                {
                    <article class="book-card">
                        <div class="book-card__status">
                            <span>@Display(booking!.BookingStatus)</span>
                            @if (!string.IsNullOrWhiteSpace(booking.BookingCode))
                            {
                                <strong dir="ltr">@booking.BookingCode</strong>
                            }
                        </div>

                        <ul class="book-specs">
                            <li>
                                <span>تاریخ نوبت</span>
                                <strong>@ToPersian(Display(booking.StrBookingDate))</strong>
                            </li>
                            <li>
                                <span>ساعت</span>
                                <strong>@ToPersian(Display(booking.StrBookingTime))</strong>
                            </li>
                            @if (!string.IsNullOrWhiteSpace(booking.BookingServerGroupLocalizedName))
                            {
                                <li>
                                    <span>نوع خدمت</span>
                                    <strong>@booking.BookingServerGroupLocalizedName</strong>
                                </li>
                            }
                            @if (!string.IsNullOrWhiteSpace(booking.DealerName))
                            {
                                <li>
                                    <span>عاملیت</span>
                                    <strong>@booking.DealerName</strong>
                                </li>
                            }
                            @if (!string.IsNullOrWhiteSpace(booking.BranchName))
                            {
                                <li>
                                    <span>شعبه</span>
                                    <strong>@booking.BranchName</strong>
                                </li>
                            }
                            @if (!string.IsNullOrWhiteSpace(booking.BookingListRepairPlace))
                            {
                                <li>
                                    <span>محل تعمیر</span>
                                    <strong>@booking.BookingListRepairPlace</strong>
                                </li>
                            }
                            @if (booking.BookingKilometer > 0)
                            {
                                <li>
                                    <span>کیلومتر</span>
                                    <strong>@ToPersian(booking.BookingKilometer.ToString("N0"))</strong>
                                </li>
                            }
                            @if (!string.IsNullOrWhiteSpace(booking.BookingRepairAdviser))
                            {
                                <li>
                                    <span>مشاور پذیرش</span>
                                    <strong>@booking.BookingRepairAdviser</strong>
                                </li>
                            }
                            @if (!string.IsNullOrWhiteSpace(booking.BookingFollowup))
                            {
                                <li>
                                    <span>پیگیری</span>
                                    <strong>@booking.BookingFollowup</strong>
                                </li>
                            }
                            @if (!string.IsNullOrWhiteSpace(Address))
                            {
                                <li class="is-block">
                                    <span>آدرس</span>
                                    <strong>@Address</strong>
                                </li>
                            }
                            @if (!string.IsNullOrWhiteSpace(booking.BranchShopPhoneNumber))
                            {
                                <li>
                                    <span>تلفن شعبه</span>
                                    <strong class="ltr" dir="ltr">@ToPersian(booking.BranchShopPhoneNumber)</strong>
                                </li>
                            }
                        </ul>
                    </article>
                }
                else
                {
                    <section class="book-empty">
                        <i class="bi bi-calendar2-x"></i>
                        <h2>نوبتی پیدا نشد</h2>
                        <p>@(string.IsNullOrWhiteSpace(errorMessage) ? "برای این شاسی نوبت ثبت‌شده‌ای وجود ندارد." : errorMessage)</p>
                        <NavLink class="book-empty__btn" href="/booking/new">رزرو نوبت جدید</NavLink>
                    </section>
                }
            }
        </div>
    </div>
}

@code {
    private List<VehicleModelDto> vehicles = new();
    private readonly HashSet<int> failedImages = new();
    private VehicleModelDto? selectedVehicle;
    private BookingDto? booking;
    private bool isLoading;
    private bool isSelecting;
    private string? errorMessage;

    private bool HasBooking => booking is not null && !string.IsNullOrWhiteSpace(booking.UniqueId);

    private string? Address =>
        FirstNonEmpty(booking?.BookingListFullAddress, booking?.BookingDealerAddress, booking?.BranchShopAddress, booking?.Location);

    protected override async Task OnInitializedAsync()
    {
        await LoadVehiclesAsync();
    }

    private async Task LoadVehiclesAsync()
    {
        isLoading = true;
        var result = await vehicleService.GetSubscriberVehicleAsync();

        if (result.StatusCode == (int)HttpStatusCode.Unauthorized)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        if (result.Succeeded)
        {
            vehicles = result.Data ?? new();
        }
        else
        {
            vehicles = new();
            snackbar.Add(result.Message ?? "دریافت لیست خودروها با خطا مواجه شد.", Severity.Error);
        }

        isLoading = false;
    }

    private async Task SelectVehicleAsync(VehicleModelDto vehicle)
    {
        if (isSelecting)
        {
            return;
        }

        if (string.IsNullOrWhiteSpace(vehicle.VinNumber))
        {
            snackbar.Add("برای این خودرو شماره شاسی ثبت نشده است.", Severity.Warning);
            return;
        }

        isSelecting = true;
        isLoading = true;
        errorMessage = null;
        booking = null;

        var result = await bookingService.GetBookByVinNumberAsync(vehicle.VinNumber);

        if (result.StatusCode == (int)HttpStatusCode.Unauthorized)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        selectedVehicle = vehicle;

        if (result.Succeeded && result.Data is not null && !string.IsNullOrWhiteSpace(result.Data.UniqueId))
        {
            booking = result.Data;
        }
        else
        {
            booking = result.Data;
            errorMessage = result.Message;
        }

        isLoading = false;
        isSelecting = false;
    }

    private void BackToVehicles()
    {
        selectedVehicle = null;
        booking = null;
        errorMessage = null;
    }

    private void OnImageError(int id)
    {
        if (failedImages.Add(id))
        {
            StateHasChanged();
        }
    }

    private string GetVehicleImage(VehicleModelDto item)
    {
        var id = item.Id ?? 0;
        if (failedImages.Contains(id))
        {
            return "img/vehicles/toyota-rav4.png";
        }

        var path = FirstNonEmpty(item.VehicleAttachment?.ImagePath, item.VehicleAttachment?.ThumbnailPath);
        if (string.IsNullOrWhiteSpace(path))
        {
            return "img/vehicles/toyota-rav4.png";
        }

        if (path.StartsWith("http://", StringComparison.OrdinalIgnoreCase)
            || path.StartsWith("https://", StringComparison.OrdinalIgnoreCase)
            || path.StartsWith("data:", StringComparison.OrdinalIgnoreCase)
            || path.StartsWith("/")
            || path.StartsWith("img/", StringComparison.OrdinalIgnoreCase))
        {
            return path;
        }

        return $"img/vehicles/{path}";
    }

    private static string Display(string? value)
        => string.IsNullOrWhiteSpace(value) ? "—" : value;

    private static string ToPersian(string? value)
        => string.IsNullOrWhiteSpace(value) ? "—" : PersianDigits.ToPersian(value);

    private static string? FirstNonEmpty(params string?[] values)
        => values.FirstOrDefault(value => !string.IsNullOrWhiteSpace(value));
}
