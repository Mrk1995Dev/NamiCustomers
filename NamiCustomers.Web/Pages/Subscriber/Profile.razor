@page "/profile"

@using NamiCustomers.Web.Services.Subscriber.Contract
@using NamiCustomers.Web.Services.Subscriber.Dto

@inject NavigationManager Navigation
@inject ISnackbar snackbar
@inject ISubscriberService subscriberService

<PageTitle>پروفایل کاربری | نامی خودرو</PageTitle>

@if (isLoading)
{
    <div class="loader-container">
        <MudProgressCircular Rounded="true" Size="MudBlazor.Size.Medium" StrokeWidth="5" Style="color: #ffffff;" Indeterminate="true" />
    </div>
}

else
{
    <div class="container direction-rtl" style="margin-top: 5.2rem;">
        <div class="card">
            <div class="card-body p-2">
                <div class="d-flex align-items-center justify-content-between">
                    <small class="ms-1">پروفایل کاربری</small>
                    <NavLink title="بازگشت" href="/">
                        <i class="bi bi-arrow-left-short" style="font-size:2rem !important;line-height:1"></i>
                    </NavLink>
                </div>
            </div>
        </div>
    </div>
    <br />
    <div class="container">
        <!-- User Information-->
        <div class="card user-info-card mb-3">
            <div class="card-body d-flex align-items-center">
                <div class="user-profile me-3">
                    <img src="sitetmeplate/img/bg-img/2.jpg" alt="">
                    <i class="bi bi-pencil"></i>
                </div>
                <div class="user-info">
                    <div class="d-flex align-items-center">
                        <h5 class="mb-1">@model.Name - @model.Family</h5>
                        @* <span class="badge bg-warning ms-2 rounded-pill">Pro</span> *@
                    </div>
                    <p class="mb-0">مشتری</p>
                </div>
            </div>
        </div>
    </div>
    <div class="container">
        <div class="card user-data-card">
            <div class="card-body">

                <div class="form-group mb-3">
                    <label class="form-label" style="color: #fff !important;">نام</label>
                    <input class="form-control" id="@model.Name" type="text" style="color: #000 !important;" @bind-value="@model.Name" placeholder="@model.Name" disabled>
                </div>

                <div class="form-group mb-3">
                    <label class="form-label" style="color: #fff !important;">نام خانوادگی</label>
                    <input class="form-control" id="@model.Family" type="text" style="color: #000 !important;" @bind-value="@model.Family" placeholder="@model.Family" disabled>
                </div>
                <div class="form-group mb-3">
                    <label class="form-label" style="color: #fff !important;">کدملی</label>
                    <input class="form-control" type="text" style="color: #000 !important;" value="@model.NationalCode" placeholder="@model.NationalCode" disabled>
                </div>
                <div class="form-group mb-3">
                    <label class="form-label" style="color: #fff !important;">شماره همراه</label>
                    <input class="form-control" id="@model.Mobile" type="text" style="color: #000 !important;" value=" @model.Mobile" placeholder="@model.Mobile" disabled>
                </div>
                <div class="form-group mb-3">
                    <label class="form-label" style="color: #fff !important;">تلفن منزل</label>
                    <input class="form-control" type="text" style="color: #000 !important;" value="@model.Phone" placeholder="model.Phone" disabled>
                </div>
                <div class="form-group mb-3">
                    <label class="form-label" style="color: #fff !important;">نشانی محل سکونت</label>
                    <input class="form-control" id="@model.Address" type="text" style="color: #000 !important;" value=" @model.Address" placeholder="@model.Address" disabled>
                </div>

            </div>
        </div>
    </div>
}


@code {
    private SubscriberDto model = new();
    private bool isLoading;

    protected override async Task OnInitializedAsync()
    {
        isLoading = true;
        var result = await subscriberService.GetSubscriberInfoAsync();
        if (result.StatusCode == (int)HttpStatusCode.Unauthorized)
            Navigation.NavigateTo("/login");

        else if (result.Succeeded)
            model = result.Data;

        else
        {

        }

        isLoading = false;
    }
}