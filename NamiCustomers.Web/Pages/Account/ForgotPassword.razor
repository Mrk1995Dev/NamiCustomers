@page "/forgotPassword/{NationalCode}"
@using NamiCustomers.Web.Services.Account.Dto
@using NamiCustomers.Web.Services.Account.Contract
@layout LoginLayout

@inject ToastService toastService
@inject IAccountService accountService
@inject NavigationManager Navigation

<PageTitle>فراموشی رمزعبور | نامی خودرو</PageTitle>

<div class="custom-container direction-rtl">
    <div class="card mt-18">
        <div class="card-body p-2">
            <div class="d-flex align-items-center justify-content-between">
                <small class="ms-2" style="font-size: 0.92rem;">تغییر رمز عبور </small>
                <NavLink title="بازگشت" href="/login"> <i class="bi bi-arrow-left-short" style="font-size:2rem !important;line-height:1"></i></NavLink>
            </div>
        </div>
    </div>
</div>
<div class="container mt-20">
    <div class="row justify-content-center">
        <div class="col-lg-8 col-md-7 col-sm-10">
            <div class="card shadow border-0 rounded-2">
                <div class="card-body p-4">
                    <div class="text-center mb-14">
                        <h3 class="fw-semibold">تغییر رمز عبور</h3>
                        <p class="text-muted mb-0">
                            لطفاً رمز عبور جدید خود را وارد نمایید.
                        </p>
                    </div>
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold text-end d-block">
                            رمز عبور جدید
                        </label>

                        <input @bind-value="Model.Password"
                               style="color: black"
                               class="form-control form-control-lg" />
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-semibold text-end d-block">
                            تکرار رمز عبور
                        </label>

                        <input @bind-value="Model.ConfirmPassword"
                               style="color: black"
                               class="form-control form-control-lg" />
                    </div>

                    <button @onclick="ResetPasswordAsync"
                            class="btn btn-primary w-100 btn-lg mt-4"
                            disabled="@isSubmitting">
                        @if (isSubmitting)
                        {
                            <span class="spinner-border spinner-border-sm mt-0 me-2"
                                  role="status"
                                  aria-hidden="true"></span>
                        }
                        else
                        {
                            <span>تغییر رمز عبور</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@if (Model.Errors.Any())
{
    foreach (var err in Model.Errors)
    {
        <p class="alert alert-danger">@err</p>
        <br />
    }
}

@code {
    [Parameter]
    public string? NationalCode { get; set; }
    private bool isSubmitting;
    private ResetPasswordDto Model = new ResetPasswordDto();

    private async Task ResetPasswordAsync()
    {
        if (isSubmitting)
            return;

        isSubmitting = true;
        if (string.IsNullOrWhiteSpace(Model.Password) || string.IsNullOrWhiteSpace(Model.ConfirmPassword))
        {
            await toastService.Show(new ToastOption()
            {
                ShowClose = true,
                ShowHeader = true,
                Category = ToastCategory.Error,
                Title = "تغییر رمزعبور",
                Content = "لطفا اطلاعات مربوطه را تکمیل کنید.",
                Animation = true
            });
        }

        else if(Model.Password != Model.ConfirmPassword)
        {
            await toastService.Show(new ToastOption()
            {
                ShowClose = true,
                ShowHeader = true,
                Category = ToastCategory.Error,
                Title = "تغییر رمزعبور",
                Content = "رمز عبور و تکرار رمز عبور باید یکسان باشد.",
                Animation = true
            });
        }

        else
        {
            Model.UserId = NationalCode;
            var result = await accountService.ResetPasswordAsync(Model);
            if (result.Succeeded)
            {
                await toastService.Show(new ToastOption()
                {
                    ShowClose = true,
                    ShowHeader = true,
                    Category = ToastCategory.Success,
                    Title = "تغییر رمزعبور",
                    Content = result.Message,
                    Animation = true
                });

                Navigation.NavigateTo("/login");
            }

            else
            {
                await toastService.Show(new ToastOption()
                {
                    ShowClose = true,
                    ShowHeader = true,
                    Category = ToastCategory.Error,
                    Title = "تغییر رمزعبور",
                    Content = result.Message is null ? "خطا در برقرار ارتباط با سرور" : result.Message,
                    Animation = true
                });
            }
        }

        isSubmitting = false;
    }
}
