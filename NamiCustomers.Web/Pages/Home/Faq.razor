@page "/faq"

<PageTitle>سوالات متداول | نامی خودرو</PageTitle>

<div class="faq-page">
    <div class="container">
        <div class="faq-top">
            <NavLink class="faq-back" href="/" title="بازگشت">
                <i class="bi bi-arrow-right"></i>
            </NavLink>
            <h1>سوالات متداول</h1>
            <span class="faq-top__spacer" aria-hidden="true"></span>
        </div>

        <section class="faq-hero">
            <div class="faq-hero__icon" aria-hidden="true">
                <i class="bi bi-chat-quote"></i>
            </div>
            <h2>پاسخ سوال‌های پرتکرار</h2>
            <p>قبل از تماس، این موارد را ببینید؛ شاید جواب همین‌جا باشد.</p>
        </section>

        <label class="faq-search">
            <i class="bi bi-search" aria-hidden="true"></i>
            <input type="search"
                   @bind="query"
                   @bind:event="oninput"
                   placeholder="جستجو در سوال‌ها..."
                   autocomplete="off" />
        </label>

        @if (!VisibleItems.Any())
        {
            <section class="faq-empty">
                <i class="bi bi-emoji-neutral"></i>
                <h3>نتیجه‌ای پیدا نشد</h3>
                <p>عبارت دیگری را امتحان کنید یا با پشتیبانی تماس بگیرید.</p>
            </section>
        }
        else
        {
            <div class="faq-list">
                @foreach (var item in VisibleItems)
                {
                    var isOpen = openIndex == item.Index;
                    <article class="faq-item @(isOpen ? "is-open" : "")">
                        <button type="button"
                                class="faq-item__head"
                                aria-expanded="@isOpen"
                                @onclick="() => Toggle(item.Index)">
                            <span class="faq-item__num">@ToPersian(item.Number)</span>
                            <span class="faq-item__title">@item.Question</span>
                            <i class="bi bi-plus-lg" aria-hidden="true"></i>
                        </button>
                        <div class="faq-item__collapse">
                            <div class="faq-item__collapse-inner">
                                <div class="faq-item__body">
                                    <p>@item.Answer</p>
                                </div>
                            </div>
                        </div>
                    </article>
                }
            </div>
        }
    </div>
</div>

@code {
    private string query = string.Empty;
    private int? openIndex = 0;

    private readonly FaqItem[] items =
    {
        new("ثبت نام خودروهای وارداتی چگونه انجام می‌شود؟",
            "مشتری می‌بایست پس از افتتاح حساب وکالتی، نسبت به خرید خودرو از طریق سامانه یکپارچه عرضه خودروهای وارداتی به نشانی SaleAuto.ir اقدام نماید."),
        new("نحوه اطلاع‌رسانی شرکت در صورت برنده شدن در سامانه یکپارچه چگونه است؟",
            "پس از دریافت لیست مشتریان، پیامک تکمیل فرآیند خرید خودرو به شماره همراهی که در سامانه یکپارچه ثبت شده، از طرف شرکت ارسال می‌گردد."),
        new("در صورت انتخاب شدن در سامانه یکپارچه، پرداخت مبلغ چگونه انجام می‌شود؟",
            "مبلغ، نحوه واریز و مهلت زمان واریز به متقاضی اطلاع‌رسانی می‌گردد."),
        new("آیا امکان واریز وجه خودرو توسط شخص دیگری وجود دارد؟",
            "خیر. مبلغ واریزی صرفاً می‌بایست از حساب شخص متقاضی به شماره حساب‌های معرفی‌شده توسط شرکت واریز شود."),
        new("آیا خرید خودرو توسط وکیل متقاضی امکان‌پذیر است؟",
            "تمامی مراحل خرید خودرو می‌بایست توسط متقاضی که در سامانه یکپارچه ثبت‌نام نموده انجام پذیرد. تنها در مرحله تحویل خودرو، امکان تحویل تا اطلاع ثانوی، بنا بر شرایط اعلامی شرکت، به وکیل مشتری امکان‌پذیر است."),
        new("اگر در زمان مشخص‌شده واریز انجام نشود، امکان تمدید مهلت وجود دارد؟",
            "خیر. طبق بخشنامه شماره ۱۱، عدم واریز وجه در مدت زمان اعلام‌شده منجر به حذف اولویت متقاضی و ابطال نوبت ایشان می‌گردد."),
        new("نحوه انصراف از خرید به چه صورت است؟",
            "در صورت تمایل به انصراف، مشتری می‌بایست درخواست کتبی خود را به دفتر مرکزی ارسال نماید."),
        new("نحوه قیمت‌گذاری خودروها به چه صورت است؟",
            "قیمت‌گذاری تمامی خودروها توسط سازمان حمایت مشخص و اعلام می‌شود."),
        new("آیا امکان خرید مستقیم خودرو از شرکت وجود دارد؟",
            "در حال حاضر خیر. عرضه تمامی خودروها صرفاً از طریق سامانه یکپارچه عرضه خودروهای وارداتی انجام می‌پذیرد."),
        new("آیا زمان و تعداد عرضه در هر مرحله مشخص است؟",
            "زمان و تعداد عرضه، بر اساس اعلام سامانه یکپارچه مشخص می‌شود."),
        new("نحوه انتخاب رنگ خودرو به چه صورت است؟",
            "در زمان انجام مراحل خرید خودرو در سامانه فروش شرکت نامی خودرو پیشرو، انتخاب اولویت‌های رنگ بر اساس خودروهای عرضه‌شده فعال می‌شود."),
        new("تخصیص رنگ خودروها به چه صورت انجام می‌پذیرد؟",
            "اولویت‌بندی تخصیص رنگ خودروها بر اساس زمان واریز/تکمیل وجه، زمان عقد قرارداد و موجودی شرکت است.")
    };

    private IEnumerable<FaqView> VisibleItems
    {
        get
        {
            var term = query.Trim();
            var number = 1;
            for (var i = 0; i < items.Length; i++)
            {
                var item = items[i];
                if (!string.IsNullOrWhiteSpace(term)
                    && item.Question.Contains(term, StringComparison.OrdinalIgnoreCase) is false
                    && item.Answer.Contains(term, StringComparison.OrdinalIgnoreCase) is false)
                {
                    continue;
                }

                yield return new FaqView(i, number++, item.Question, item.Answer);
            }
        }
    }

    private void Toggle(int index)
    {
        openIndex = openIndex == index ? null : index;
    }

    private static string ToPersian(int number)
    {
        var chars = number.ToString().ToCharArray();
        for (var i = 0; i < chars.Length; i++)
        {
            chars[i] = (char)('\u06F0' + (chars[i] - '0'));
        }

        return new string(chars);
    }

    private sealed record FaqItem(string Question, string Answer);

    private sealed record FaqView(int Index, int Number, string Question, string Answer);
}
