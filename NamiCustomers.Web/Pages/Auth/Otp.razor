@page "/otp"
@attribute [AllowAnonymous]
@using NamiCustomers.Web.Utilities
@using NamiCustomers.Web.Services.Auth.AuthServices.Dto
@implements IDisposable
@layout LoginLayout
@inject HttpClient Http
@inject NavigationManager NavigationManager
@inject IAuthService authService
@inject ToastService toastService
@inject IJSRuntime JS

<div class="login-wrapper d-flex align-items-center justify-content-center">
    <div class="custom-container">
        <div class="text-center">
            <img class="login-intro-img" src="/SiteTmeplate/img/bg-img/logo.png" alt="نامی خودرو" />
            <h3 class="otp-title">کد تایید را وارد نمایید</h3>
            <p class="otp-hint mb-4">
                کد تایید به شماره همراه
                <strong class="otp-phone" dir="ltr">@MobileNumber</strong>
                ارسال گردید.
            </p>
        </div>

        <div class="otp-verify-form mt-2">
            <div class="otp-boxes" dir="ltr">
                @for (var i = 0; i < DigitCount; i++)
                {
                    var index = i;
                    <input @key="index"
                           type="text"
                           inputmode="text"
                           maxlength="5"
                           autocomplete="@(index == 0 ? "one-time-code" : "off")"
                           class="otp-box @(string.IsNullOrEmpty(digits[index]) ? "" : "is-filled")"
                           dir="ltr"
                           lang="fa"
                           value="@PersianDigits.ToPersian(digits[index])"
                           @ref="inputRefs[index]"
                           @oninput="e => OnDigitInput(index, e)"
                           @onkeydown="e => OnDigitKeyDown(index, e)"
                           @onfocus="() => OnBoxFocus(index)"
                           aria-label="@($"رقم {index + 1} از {DigitCount}")" />
                }
            </div>

            <button class="auth-btn" type="button" disabled="@isSubmitting" @onclick="ConfirmOtpAsync">
                @if (isSubmitting)
                {
                    <span class="auth-btn-spinner" aria-hidden="true"></span>
                    <span>در حال بررسی...</span>
                }
                else
                {
                    <span>ورود به سامانه</span>
                    <i class="bi bi-arrow-left" aria-hidden="true"></i>
                }
            </button>

            <div class="otp-resend-wrap text-center">
                <p class="otp-resend mt-3 mb-0">
                    کد تایید را دریافت نکرده‌اید؟
                    <span class="otp-sec @(secondsRemaining <= 10 && secondsRemaining > 0 ? "otp-sec-urgent" : null)">
                        @if (secondsRemaining > 0)
                        {
                            <span class="otp-countdown" dir="ltr">@($"{secondsRemaining / 60}:{(secondsRemaining % 60):D2}")</span>
                            <span> تا دریافت مجدد کد</span>
                        }
                        else
                        {
                            <button type="button"
                                    class="resendOTP"
                                    disabled="@isResending"
                                    @onclick="ResendOtpAsync">
                                @(isResending ? "در حال ارسال..." : "دریافت مجدد کد")
                            </button>
                        }
                    </span>
                </p>
            </div>
        </div>
    </div>
</div>

@code {
    private const int DigitCount = 5;
    private const int ResendCooldownSeconds = 120;

    [Parameter]
    [SupplyParameterFromQuery(Name = "mobile")]
    public string? MobileNumber { get; set; }

    [Parameter]
    [SupplyParameterFromQuery(Name = "nationalCode")]
    public string? NationalCode { get; set; }

    private string[] digits = Enumerable.Repeat(string.Empty, DigitCount).ToArray();
    private ElementReference[] inputRefs = new ElementReference[DigitCount];
    private bool isSubmitting = false;
    private bool isResending = false;
    private string? otpCode;
    private bool focusedOnFirstRender;
    private int secondsRemaining = ResendCooldownSeconds;
    private System.Threading.Timer? resendTimer;

    protected override void OnInitialized()
    {
        StartResendTimer();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !focusedOnFirstRender)
        {
            focusedOnFirstRender = true;
            try
            {
                for (var i = 0; i < DigitCount; i++)
                {
                    await JS.InvokeVoidAsync("namiAuth.bindPersian", inputRefs[i]);
                }
            }
            catch
            {
            }

            await FocusBox(0);
        }
    }

    private void StartResendTimer()
    {
        resendTimer?.Dispose();
        secondsRemaining = ResendCooldownSeconds;
        resendTimer = new System.Threading.Timer(_ =>
        {
            if (secondsRemaining <= 0)
            {
                resendTimer?.Dispose();
                return;
            }

            secondsRemaining--;
            _ = InvokeAsync(StateHasChanged);
        }, null, TimeSpan.FromSeconds(1), TimeSpan.FromSeconds(1));
    }

    private async Task ResendOtpAsync()
    {
        if (secondsRemaining > 0 || isResending)
            return;

        if (string.IsNullOrWhiteSpace(MobileNumber) || string.IsNullOrWhiteSpace(NationalCode))
        {
            await toastService.Show(new ToastOption()
            {
                ShowClose = true,
                ShowHeader = true,
                Category = ToastCategory.Error,
                Title = "ارسال مجدد",
                Content = "اطلاعات ورود ناقص است. لطفا دوباره وارد شوید.",
                Animation = true
            });
            NavigationManager.NavigateTo("/login");
            return;
        }

        isResending = true;
        try
        {
            var result = await authService.LoginAsync(new LoginRequestDto
            {
                NationalCode = NationalCode,
                PhoneNumber = MobileNumber
            });

            if (result.Succeeded)
            {
                StartResendTimer();
                await toastService.Show(new ToastOption()
                {
                    ShowClose = true,
                    ShowHeader = true,
                    Category = ToastCategory.Success,
                    Title = "ارسال مجدد",
                    Content = $"کد ورود به شماره {MobileNumber} ارسال شد.",
                    Animation = true
                });
            }
            else
            {
                await toastService.Show(new ToastOption()
                {
                    ShowClose = true,
                    ShowHeader = true,
                    Category = ToastCategory.Error,
                    Title = "ارسال مجدد",
                    Content = string.IsNullOrWhiteSpace(result.Message)
                        ? "ارسال مجدد کد با خطا مواجه شد."
                        : result.Message,
                    Animation = true
                });
            }
        }
        catch
        {
            await toastService.Show(new ToastOption()
            {
                ShowClose = true,
                ShowHeader = true,
                Category = ToastCategory.Error,
                Title = "ارسال مجدد",
                Content = "خطا در برقراری ارتباط با سرور",
                Animation = true
            });
        }
        finally
        {
            isResending = false;
        }
    }

    public void Dispose()
    {
        resendTimer?.Dispose();
    }

    private async Task OnDigitInput(int index, ChangeEventArgs e)
    {
        var nums = PersianDigits.ToEnglish(e.Value?.ToString());

        if (nums.Length == 0)
        {
            digits[index] = string.Empty;
            SyncOtpCode();
            await RefreshDigitDisplay(index);
            return;
        }

        if (nums.Length >= DigitCount)
        {
            FillFrom(0, nums);
            await RefreshAllDigitDisplays();
            await FocusBox(DigitCount - 1);
            SyncOtpCode();
            return;
        }

        if (nums.Length > 1)
        {
            FillFrom(index, nums);
            await RefreshAllDigitDisplays();
            await FocusBox(Math.Min(index + nums.Length, DigitCount - 1));
            SyncOtpCode();
            return;
        }

        digits[index] = nums;
        SyncOtpCode();
        await RefreshDigitDisplay(index);

        if (index < DigitCount - 1)
        {
            await FocusBox(index + 1);
        }
    }

    private async Task OnDigitKeyDown(int index, KeyboardEventArgs e)
    {
        if (e.Key == "Backspace")
        {
            if (string.IsNullOrEmpty(digits[index]) && index > 0)
            {
                digits[index - 1] = string.Empty;
                SyncOtpCode();
                await RefreshDigitDisplay(index - 1);
                await FocusBox(index - 1);
            }
            else
            {
                digits[index] = string.Empty;
                SyncOtpCode();
                await RefreshDigitDisplay(index);
            }
        }
        else if (e.Key == "ArrowLeft" && index > 0)
        {
            await FocusBox(index - 1);
        }
        else if (e.Key == "ArrowRight" && index < DigitCount - 1)
        {
            await FocusBox(index + 1);
        }
        else if (e.Key == "Enter")
        {
            await ConfirmOtpAsync();
        }
    }

    private void FillFrom(int startIndex, string nums)
    {
        for (var i = 0; i < DigitCount; i++)
        {
            var source = i - startIndex;
            digits[i] = source >= 0 && source < nums.Length
                ? nums[source].ToString()
                : (i < startIndex ? digits[i] : string.Empty);
        }
    }

    private void SyncOtpCode()
    {
        otpCode = string.Concat(digits);
    }

    private async Task RefreshDigitDisplay(int index)
    {
        if (index < 0 || index >= DigitCount)
        {
            return;
        }

        try
        {
            await JS.InvokeVoidAsync("namiAuth.setValue", inputRefs[index], PersianDigits.ToPersian(digits[index]));
        }
        catch
        {
        }
    }

    private async Task RefreshAllDigitDisplays()
    {
        for (var i = 0; i < DigitCount; i++)
        {
            await RefreshDigitDisplay(i);
        }
    }

    private async Task OnBoxFocus(int index)
    {
        try
        {
            await JS.InvokeVoidAsync("namiAuth.selectInput", inputRefs[index]);
        }
        catch
        {
        }
    }

    private async Task FocusBox(int index)
    {
        if (index < 0 || index >= DigitCount)
        {
            return;
        }

        try
        {
            await inputRefs[index].FocusAsync();
            await JS.InvokeVoidAsync("namiAuth.selectInput", inputRefs[index]);
        }
        catch
        {
            // Element may not be ready on first render.
        }
    }

    async Task ConfirmOtpAsync()
    {
        SyncOtpCode();

        if (string.IsNullOrWhiteSpace(otpCode) || otpCode.Length < DigitCount)
        {
            await toastService.Show(new ToastOption()
            {
                ShowClose = true,
                ShowHeader = true,
                Category = ToastCategory.Error,
                Title = "کد دوعاملی",
                Content = "لطفا کد دو عاملی را وارد کنید.",
                Animation = true
            });
            return;
        }

        isSubmitting = true;

        try
        {
            var result = await authService.ConfirmOtpAsync(otpCode);

            if (result.Succeeded)
                NavigationManager.NavigateTo("/");

            else
                await toastService.Show(new ToastOption()
                {
                    ShowClose = true,
                    ShowHeader = true,
                    Category = ToastCategory.Error,
                    Title = "کد دوعاملی",
                    Content = result.Message,
                    Animation = true
                });
        }
        catch
        {
            await toastService.Show(new ToastOption()
            {
                ShowClose = true,
                ShowHeader = true,
                Category = ToastCategory.Error,
                Title = "کد دوعاملی",
                Content = "خطا در برقراری ارتباط با سرور",
                Animation = true
            });
        }

        finally
        {
            isSubmitting = false;
        }
    }
}
