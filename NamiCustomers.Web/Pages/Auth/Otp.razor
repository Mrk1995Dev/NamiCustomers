@page "/otp"
@layout LoginLayout
@using MudX
@using System.Net.Http.Json
@inject HttpClient Http
@inject NavigationManager NavigationManager

<div class="login-wrapper d-flex align-items-center justify-content-center">
    <div class="custom-container">
        <div class="text-center">
            <img class="login-intro-img" src="/SiteTmeplate/img/bg-img/logo.png" alt="" />
            <h3>کد تایید را وارد نمایید</h3>
            <p class="mb-4">کد تایید به شماره همراه <strong>@MobileNumber</strong> ارسال گردید.</p>
        </div>

        <div class="otp-verify-form mt-2" style="direction:rtl !important; gap: 4px;">
            <div class="input-group mb-3 otp-input-group">
                @for (var i = 0; i < 5; i++)
                {
                    var index = i;
                    <input class="form-control"
                           @ref="inputRefs[index]"
                           @bind="digits[index]"
                           @bind:event="oninput"
                           @onkeyup="e => OnDigitKeyUp(e, index)"
                           type="text" inputmode="numeric" pattern="[0-9]*"
                           style="color:#000 !important; border-radius: 8px; gap: 4px;"
                           maxlength="1"
                           autofocus="@(index == 0)" />
                }
            </div>

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="alert alert-danger py-2">@errorMessage</div>
            }

            <MudButton Color="Color.Error" Variant="Variant.Filled"
                       OnClick="ConfirmOtpAsync" Disabled="@isSubmitting"
                       FullWidth="true">
                @(isSubmitting ? "در حال بررسی..." : "ورود به سامانه")
            </MudButton>
        </div>

        <div class="login-meta-data text-center">
            <p class="mt-3 mb-0">کد تایید را دریافت نکرده اید؟ <span class="otp-sec" id="resendOTP"></span></p>
        </div>
    </div>
</div>

@code {
    [Parameter]
    [SupplyParameterFromQuery(Name = "mobile")]
    public string? MobileNumber { get; set; }

    private string?[] digits = new string?[5];
    private ElementReference[] inputRefs = new ElementReference[5];
    private bool isSubmitting = false;
    private string? errorMessage;

    private string Code => string.Concat(digits.Select(d => d ?? ""));

    private async Task OnDigitKeyUp(KeyboardEventArgs e, int index)
    {
        if (!string.IsNullOrEmpty(digits[index]) && digits[index]!.Length > 1)
        {
            digits[index] = digits[index]![^1..];
        }

        if (e.Key != "Backspace" && !string.IsNullOrEmpty(digits[index]) && index > 0)
        {
            await inputRefs[index - 1].FocusAsync();
        }
        else if (e.Key == "Backspace" && string.IsNullOrEmpty(digits[index]) && index < 4)
        {
            await inputRefs[index + 1].FocusAsync();
        }
    }

    async Task ConfirmOtpAsync()
    {
        var code = Code;
        if (string.IsNullOrWhiteSpace(code) || code.Length < 5)
        {
            errorMessage = "لطفاً کد ۵ رقمی را کامل وارد کنید.";
            return;
        }

        isSubmitting = true;
        errorMessage = null;

        try
        {
            var url = $"api/v1/Account/CheckOtp?mobile={Uri.EscapeDataString(MobileNumber ?? "")}&otp={Uri.EscapeDataString(code)}";
            var response = await Http.GetAsync(url);

            if (response.IsSuccessStatusCode)
            {
                NavigationManager.NavigateTo("/");
            }
            else
            {
                errorMessage = "کد تایید وارد شده صحیح نیست.";
            }
        }
        catch
        {
            errorMessage = "خطا در برقراری ارتباط با سرور.";
        }
        finally
        {
            isSubmitting = false;
        }
    }
}