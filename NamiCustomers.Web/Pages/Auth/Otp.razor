@page "/otp"
@layout LoginLayout
@inject HttpClient Http
@inject NavigationManager NavigationManager
@inject ISnackbar snackbar
@inject IAuthService authService

<div class="login-wrapper d-flex align-items-center justify-content-center">
    <div class="custom-container">
        <div class="text-center">
            <img class="login-intro-img" src="/SiteTmeplate/img/bg-img/logo.png" alt="" />
            <h3>کد تایید را وارد نمایید</h3>
            <p class="mb-4">کد تایید به شماره همراه <strong>@MobileNumber</strong> ارسال گردید.</p>
        </div>

        <div class="otp-verify-form mt-2" style="direction:rtl !important; gap: 4px;">
            <div class="input-group mb-3 otp-input-group">
                <input class="form-control"
                       @bind="otpCode"
                       @oninput="OnOtpInput"
                       type="text" inputmode="numeric" pattern="[0-9]*"
                       style="color:#000 !important; border-radius: 6px;"
                       maxlength="5"
                       autofocus />
            </div>

            <button class="btn btn-primary w-100" type="submit" disabled="@isSubmitting" @onclick="ConfirmOtpAsync">
                @(isSubmitting ? "در حال بررسی..." : "ورود به سامانه")
            </button>
        </div>

        <div class="login-meta-data text-center">
            <p class="mt-3 mb-0">کد تایید را دریافت نکرده اید؟ <span class="otp-sec" id="resendOTP"></span></p>
        </div>
    </div>
</div>

@code {
    [Parameter]
    [SupplyParameterFromQuery(Name = "mobile")]
    public string? MobileNumber { get; set; }

    private string?[] digits = new string?[5];
    private ElementReference[] inputRefs = new ElementReference[5];
    private bool isSubmitting = false;
    private string? errorMessage;

    private string? otpCode;

    private void OnOtpInput(ChangeEventArgs e)
    {
        var value = e.Value?.ToString() ?? "";

        value = new string(value.Where(char.IsDigit).ToArray());

        if (value.Length > 5)
        {
            value = value[..5];
        }

        otpCode = value.Trim();
    }

    async Task ConfirmOtpAsync()
    {
        if (string.IsNullOrWhiteSpace(otpCode) || otpCode.Length < 5)
        {
            snackbar.Add("لطفا کد دو عاملی را وارد کنید.", Severity.Normal, configure =>
            {
                configure.IconColor = Color.Error;
                configure.SuccessIcon = Icons.Material.Filled.Error;
                configure.CloseAfterNavigation = false;
            });
        }

        isSubmitting = true;

        try
        {
            var result = await authService.ConfirmOtpAsync(otpCode);

            if (result.Succeeded)
                NavigationManager.NavigateTo("/");

            else
                snackbar.Add(result.Message, Severity.Normal, configure =>
             {
                 configure.IconColor = Color.Error;
                 configure.SuccessIcon = Icons.Material.Filled.Error;
                 configure.CloseAfterNavigation = false;
             });
        }
        catch
        {
            snackbar.Add("خطا در برقراری ارتباط با سرور", Severity.Normal, configure =>
             {
                 configure.IconColor = Color.Error;
                 configure.SuccessIcon = Icons.Material.Filled.Error;
                 configure.CloseAfterNavigation = false;
             });
        }

        finally
        {
            isSubmitting = false;
        }
    }
}