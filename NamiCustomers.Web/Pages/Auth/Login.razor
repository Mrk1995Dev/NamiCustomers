@page "/login"
@attribute [AllowAnonymous]
@using NamiCustomers.Web.Utilities
@inject IAuthService AuthService
@inject NavigationManager Navigation
@inject ISnackbar snackbar
@inject ToastService toastService
@inject IJSRuntime JS
@layout LoginLayout

<PageTitle>ورود به باشگاه مشتریان | نامی خودرو</PageTitle>

<div class="login-wrapper d-flex align-items-center justify-content-center">
    <div class="custom-container">
        <div class="text-center px-4">
            <img class="login-intro-img" src="/SiteTmeplate/img/bg-img/logo.png" alt="نامی خودرو" />
        </div>

        <div class="register-form mt-4">
            <h6 class="auth-heading mb-3 text-center">سامانه خدمات پس از فروش نامی خودرو پیشرو</h6>

            <EditForm Model="@LoginModel" OnValidSubmit="() => HandleLogin()">
                <DataAnnotationsValidator />

                <div class="auth-field">
                    <i class="bi bi-person auth-field-icon" aria-hidden="true"></i>
                    <input class="auth-input"
                           type="text"
                           inputmode="text"
                           @ref="nationalCodeInput"
                           value="@PersianDigits.ToPersian(LoginModel.NationalCode)"
                           @oninput="OnNationalCodeInput"
                           maxlength="10"
                           autocomplete="username"
                           lang="fa"
                           placeholder="کد ملی" />
                    <ValidationMessage For="@(() => LoginModel.NationalCode)" />
                </div>

                <div class="auth-field">
                    <i class="bi bi-phone auth-field-icon" aria-hidden="true"></i>
                    <input class="auth-input"
                           type="text"
                           inputmode="text"
                           @ref="phoneInput"
                           value="@PersianDigits.ToPersian(LoginModel.PhoneNumber)"
                           @oninput="OnPhoneNumberInput"
                           maxlength="11"
                           autocomplete="tel"
                           lang="fa"
                           placeholder="تلفن همراه" />
                    <ValidationMessage For="@(() => LoginModel.PhoneNumber)" />
                </div>

                @if (!string.IsNullOrEmpty(ErrorMessage))
                {
                    <div class="auth-alert">@ErrorMessage</div>
                }

                <button class="auth-btn" type="submit" disabled="@isSubmitting">
                    @if (isSubmitting)
                    {
                        <span class="auth-btn-spinner" aria-hidden="true"></span>
                        <span>در حال ارسال...</span>
                    }
                    else
                    {
                        <span>ورود</span>
                        <i class="bi bi-arrow-left" aria-hidden="true"></i>
                    }
                </button>
            </EditForm>
        </div>

        <div class="login-meta-data text-center">
            <button type="button" @onclick="NavigateToForgotPassword" class="auth-forgot">
                رمز عبور خود را فراموش کرده‌اید؟
            </button>
        </div>
    </div>
</div>

@code {
    private LoginRequestDto LoginModel = new();
    private string ErrorMessage = string.Empty;
    private bool isSubmitting = false;
    private ElementReference nationalCodeInput;
    private ElementReference phoneInput;
    private bool persianBound;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (persianBound)
        {
            return;
        }

        try
        {
            await JS.InvokeVoidAsync("namiAuth.bindPersian", nationalCodeInput);
            await JS.InvokeVoidAsync("namiAuth.bindPersian", phoneInput);
            persianBound = true;
        }
        catch
        {
        }
    }

    private async Task OnNationalCodeInput(ChangeEventArgs e)
    {
        LoginModel.NationalCode = PersianDigits.ToEnglish(e.Value?.ToString());
        await SetPersianValue(nationalCodeInput, LoginModel.NationalCode);
    }

    private async Task OnPhoneNumberInput(ChangeEventArgs e)
    {
        LoginModel.PhoneNumber = PersianDigits.ToEnglish(e.Value?.ToString());
        await SetPersianValue(phoneInput, LoginModel.PhoneNumber);
    }

    private async Task SetPersianValue(ElementReference input, string value)
    {
        try
        {
            await JS.InvokeVoidAsync("namiAuth.setValue", input, PersianDigits.ToPersian(value));
        }
        catch
        {
        }
    }

    private async Task HandleLogin()
    {
        if(string.IsNullOrWhiteSpace(LoginModel.NationalCode) || string.IsNullOrWhiteSpace(LoginModel.PhoneNumber))
        {
            await toastService.Show(new ToastOption()
            {
                ShowClose = true,
                ShowHeader = true,
                Category = ToastCategory.Error,
                Title = "ورود",
                Content = "کاربر گرامی, لطفا اطلاعات مربوطه را وارد کنید.",
                Animation = true
            });
            return;
        }

        isSubmitting = true;
        var result = await AuthService.LoginAsync(LoginModel);
        if(result.Succeeded)
        {
            await toastService.Show(new ToastOption()
            {
                ShowClose = true,
                ShowHeader = true,
                Category = ToastCategory.Error,
                Title = "ورود",
                Content = $"کد ورود به شماره {LoginModel.PhoneNumber} ارسال شد.",
                Animation = true
            });

            Navigation.NavigateTo($"/otp?mobile={LoginModel.Email}");
        }

        else
        {
            ErrorMessage = result?.Message ?? "";
        }

        isSubmitting = false;
    }

    async Task NavigateToForgotPassword ()
    {
        if (string.IsNullOrWhiteSpace(LoginModel.NationalCode))
        {
            await toastService.Show(new ToastOption()
                {
                    ShowClose = true,
                    ShowHeader = true,
                    Category = ToastCategory.Error,
                    Title = "فراموشی رمز عبور",
                    Content = "لطفا کد ملی خود را وارد کنید.",
                    Animation = true
                });
        }

        else
            Navigation.NavigateTo($"/forgotPassword/{LoginModel.NationalCode}");
    }
}
