@page "/customer/info/{id:int}"
@using NamiCustomers.Abstractions.Dtos
@using NamiCustomers.Abstractions.Dtos.Subscribers
@using NamiCustomers.Web.Services.CustomerService.Implementation
 
@inject CustomerService customerService

<h3>جزئیات مشتری</h3>

@if (customer == null)
{
    <p>در حال بارگذاری...</p>
}
else
{
    <div class="card p-3">
        <p><strong>نام:</strong> @customer.Data.Name</p>
        <p><strong>آدرس:</strong> @customer.Data.Address</p>
        <p><strong>شهر:</strong> @customer.Data.CityName</p>
        <p><strong>تلفن:</strong> @customer.Data.PhoneNumber</p>
 
    </div>
}

@code {
    [Parameter] 
    public int id { get; set; }

    ResultDto<SubscriberDto  > customer;

    protected override async Task OnInitializedAsync()
    {
        customer = await customerService.GetByIdAsync(id);
    }

}
