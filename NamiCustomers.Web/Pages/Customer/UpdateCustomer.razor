@page "/customer/edit/{customerId:int}"
 
@using NamiCustomers.Abstractions.Dtos.Subscribers
@using NamiCustomers.Web.Services.CustomerService.Implementation
 
@inject NavigationManager navigation
@inject CustomerService customerService
@rendermode InteractiveServer


<h3>ویرایش مشتری</h3>

@if (customer == null)
{
    <p>در حال بارگذاری...</p>
}
else
{
    <EditForm FormName="EditCustomerForm" Model="@customer" OnValidSubmit="@HandleValidSubmit">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="mb-3">
            <label>نام</label>
            <InputText class="form-control" @bind-Value="customer.Name" />
        </div>
        <div class="mb-3">
            <label>آدرس</label>
            <InputText class="form-control" @bind-Value="customer.Address" />
        </div>
        <div class="mb-3">
            <label>شهر</label>
            <InputSelect class="form-control" @bind-Value="customer.CityId">
                @foreach (var city in Cities)
                {
                    <option value="@city.Id">@city.Title</option>
                }
            </InputSelect>
        </div>
        <div class="mb-3">
            <label>تلفن</label>
            <InputText class="form-control" @bind-Value="customer.Phone" />
        </div>
         

        <button type="submit" class="btn btn-success">ثبت تغییرات</button>
    </EditForm>
}

@code {
    [Parameter]
    public int CustomerId { get; set; }

    private SubscriberDto customer;
    private List<CityDto> Cities = new();

    protected override async Task OnInitializedAsync()
    {
        Cities = await customerService.GetAllCitiesAsync();
        customer = (await customerService.GetByIdAsync(CustomerId)).Data;
    }

    private async Task HandleValidSubmit()
    {
        var modifiedCustomer = new SubscriberDto
            {
                Id = customer.Id,
                Name = customer.Name,
                CityId = customer.CityId,
                Phone = customer.Phone,
                Address = customer.Address,
            };
        var response = await customerService.UpdateAsync(modifiedCustomer);
        if (response.Succeeded)
        {
            navigation.NavigateTo("/");
        }

    }
}
