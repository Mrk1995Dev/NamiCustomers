@page "/Vehicle/ActiveMainChassisGuarantee"
@using NamiCustomers.Web.Services.Vehicle.Dto
@using NamiCustomers.Web.Services.Vehicle.Contract
@using NamiCustomers.Web.Services.LocalStorage
@using NamiCustomers.Web.Services.Vehicle.Implementation

@inject IVehicleService vehicleService
@inject ILocalStorageService localStorageService
@inject ISnackbar snackbar
@inject NavigationManager Navigation
@implements IDisposable
@inject VehicleContext VehicleContext
@inject ToastService ToastService

<PageTitle>استعلام گارانتی های فعال | نامی خودرو</PageTitle>

    @if (!isLoading)
{
    <div class="loader-container">
        <MudProgressCircular Rounded="true" Size="MudBlazor.Size.Medium" StrokeWidth="5" Style="color: #ffffff;" Indeterminate="true" />
    </div>
}


else
{
    @if (Model.ChassisGuaranteeListWarrantyStatus == "Has Guarantee")
    {
@*         <br />
        <div class="container">

            <div class="divider divider-center-icon mt-3">
                <i class="bi bi-gear"></i>
            </div>

        </div> *@
        <br />
        <div class="container">
            <div class="container direction-rtl" style="padding: 0;">
                <div class="card">
                    <div class="card-body p-2">
                        <div class="d-flex align-items-center justify-content-between">
                            <small class="ms-1">استعلام گارانتی</small>
                            <form action="#">
                                <NavLink title="بازگشت" href="/"> <i class="bi bi-arrow-left-short" style="font-size:2rem !important;line-height:1"></i></NavLink>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
            <br />
            <div class="card comparison-table-one">
                <div class="card-body">
                    <table class="table mb-0">
                        <thead class="thead-light">
                            <tr style="text-align:start">
                                <th colspan="2">
                                    <div style="display:flex; align-items:center; gap:6px; margin-bottom: 12px;">
                                        <MudIcon Icon="@Icons.Material.Rounded.AutoFixHigh" Color="MudBlazor.Color.Default" Size="MudBlazor.Size.Small" />
                                        <span>نتیجه استعلام گارانتی</span>
                                    </div>
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <th>نوع گارانتی</th>
                                <td>@Model.GuarantyTypeName</td>
                            </tr>
                            <tr>
                                <th>تاریخ ثبت</th>
                                <td>@Model.StrRegisterDateTime</td>
                            </tr>
                            <tr>
                                <th>تاریخ انقضا</th>
                                <td>@Model.StrExpireDateTime</td>
                            </tr>
                            <tr>
                                <th>کیلومتر گارانتی</th>
                                <td>@string.Format("{0:#,##0}", Model.GuaranteeMileage) کیلومتر</td>
                            </tr>
                            <tr>
                                <th>مدت گارانتی</th>
                                <td>@Model.GuaranteeDuration ماه</td>
                            </tr>
                            <tr>
                                <th>وضعیت گارانتی</th>
                                @if (Model.ChassisGuaranteeListWarrantyStatus == "Has Guarantee")
                                {
                                    <td><i class="text-success bi bi-check-lg fz-16"></i></td>
                                }
                                else
                                {
                                    <td><i class="text-danger bi bi-x-lg"></i></td>
                                }
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
    else if (!string.IsNullOrEmpty(Model.VinNumber))
    {
        <br />
        <div class="container">
            <div class="divider divider-center-icon mt-3">
                <i class="bi bi-gear"></i>
            </div>
        </div>
        <br />
        <div class="container">
            <div class="card comparison-table-one">
                <div class="card-body">
                    <div class="alert custom-alert-one alert-danger alert-dismissible fade show" role="alert">
                        <i class="bi bi-x-circle"></i>
                        هیچ موردی یافت نشد!
                    </div>
                </div>
            </div>
        </div>

    }
}


@code {
    private ActiveMainChassisGuaranteeResponse Model = new();
    private bool isLoading;

    protected override async Task OnInitializedAsync()
    {
        VehicleContext.VinChanged += OnVinChanged;
        await LoadWarrantyDataAsync();
    }

    private async Task LoadWarrantyDataAsync()
    {
        string vin = await localStorageService.GetItemAsync("vin");
        if (string.IsNullOrWhiteSpace(vin))
        {
            Navigation.NavigateTo("/");
            await ToastService.Show(new ToastOption()
            {
                ShowHeader = true,
                Category = ToastCategory.Warning,
                Title = "اعلان",
                WarningIcon = Icons.Material.Outlined.Warning,
                Content = "کاربر گرامی, لطفا شماره شاسی خود را انتخاب کنید.",
                Animation = true
            });
            return;
        }

        isLoading = false;
        var result = await vehicleService.GetActiveMainChassisGuarantee(vin);
        if (result.StatusCode == (int)HttpStatusCode.Unauthorized)
            Navigation.NavigateTo("/login");

        else if (result.Succeeded)
            Model = result.Data;

        else
        {
            await ToastService.Show(new ToastOption()
            {
                ShowHeader = true,
                Category = ToastCategory.Warning,
                Title = "اعلان",
                WarningIcon = Icons.Material.Outlined.Warning,
                Content = result.Message,
                Animation = true
            });
        }

        isLoading = true;
    }

    private async void OnVinChanged()
    {
        var vin = VehicleContext.SelectedVin;

        if (vin is null)
            return;

        await LoadWarrantyDataAsync();

        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        VehicleContext.VinChanged -= OnVinChanged;
    }
}
