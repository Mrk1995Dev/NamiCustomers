@page "/vehicle/PartsPriceByChassis"

@inject IVehicleService vehicleService
<PageTitle>استعلام بهای قطعات | نامی خودرو</PageTitle>

<h4 class="title-part"> استعلام بهای قطعات</h4>
<hr />

<EditForm Model="@Model" OnValidSubmit="SearchAsync">
    <DataAnnotationsValidator />

    <div class="search-form-container">

        <div class="form-group mb-3">
            <label class="form-label">شماره قطعه</label>
            <InputText style="color: #000" @bind-Value="Model.PartNo"
                       class="form-control" />
        </div>

        <div class="form-group mb-3">
            <label class="form-label">نام قطعه</label>
            <InputText style="color: #000" @bind-Value="Model.PartName"
                       class="form-control" />
        </div>

        <button type="submit" class="btn btn-primary search-btn">
            جستجو
        </button>

    </div>
</EditForm>

@code {
    private PartsPriceByChassisRequest Model = new();


    async Task SearchAsync()
    {
        var result = await vehicleService.GetPartsPriceByChassisAsync(Model);
    }
}
