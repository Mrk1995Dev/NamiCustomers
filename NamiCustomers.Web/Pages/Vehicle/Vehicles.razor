@page "/vehicle"

@inject IVehicleService vehicleService
@inject NavigationManager Navigation

<PageTitle> خودروهای من | نامی خودرو</PageTitle>
@if (isLoading)
{
    <div class="loader-container">
        <MudProgressCircular Rounded="true" Size="MudBlazor.Size.Medium" StrokeWidth="5" Style="color: #ffffff;" Indeterminate="true" />
    </div>
}

else
{

    <div class="page-content-wrapper py-3">
        <div class="shop-pagination pb-3">
            <div class="container">
                <div class="card">
                    <div class="card-body p-2">
                        <div class="d-flex align-items-center justify-content-between">
                            <small class="ms-1">لیست خودروها</small>
                            <NavLink href="/add/vehicle" class="btn m-1 btn-primary btn-sm">
                                <i class="bi bi-plus"></i>
                                افزودن خودرو
                            </NavLink>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="top-products-area product-list-wrap">
            <div class="container">
                <div class="row g-3">
                    @if (Model.Count == 0)
                    {
                        <div class="col-12">
                            <div class="card">
                                <div class="card-body text-center py-4">خودرویی ثبت نشده است</div>
                            </div>
                        </div>
                    }

                    @foreach (var item in Model)
                    {
                        var vehicleId = item.Id ?? 0;
                        var orbit = GetOrbit(vehicleId);

                        <div class="col-12" @key="vehicleId">
                            <div class="card vehicle-card">
                                <div class="card-body p-0">
                                    <div class="car-orbit @(orbit.Dragging ? "is-dragging" : "")"
                                         style="@OrbitStyle(orbit)"
                                         @onpointerdown="e => OnOrbitDown(vehicleId, e)"
                                         @onpointermove="e => OnOrbitMove(vehicleId, e)"
                                         @onpointerup="() => OnOrbitUp(vehicleId)"
                                         @onpointercancel="() => OnOrbitUp(vehicleId)"
                                         @onpointerleave="() => OnOrbitUp(vehicleId)">
                                        <div class="car-orbit__stage">
                                            <div class="car-orbit__rig">
                                                <div class="car-orbit__floor"></div>
                                                <img class="car-orbit__car"
                                                     src="@GetVehicleImage(item)"
                                                     alt="@Display(item.SelectedVehicleCommonName)"
                                                     draggable="false"
                                                     @onerror="() => OnImageError(vehicleId)" />
                                            </div>
                                        </div>
                                        <span class="car-orbit__hint">برای چرخش بکشید</span>
                                        @if (item.IsDefault)
                                        {
                                            <span class="car-orbit__badge">پیش‌فرض</span>
                                        }
                                    </div>

                                    <div class="vehicle-card__body">
                                        <div class="vehicle-card__head">
                                            <h3 class="vehicle-card__title">@Display(item.SelectedVehicleCommonName)</h3>
                                            <div class="vehicle-card__tags">
                                                @if (!string.IsNullOrWhiteSpace(item.ProductYear))
                                                {
                                                    <span class="vehicle-tag">@item.ProductYear</span>
                                                }
                                                @if (!string.IsNullOrWhiteSpace(item.ChassisUsageTypeName))
                                                {
                                                    <span class="vehicle-tag">@item.ChassisUsageTypeName</span>
                                                }
                                            </div>
                                        </div>

                                        @if (!string.IsNullOrWhiteSpace(item.SelectedVehicleDescription)
                                             && !string.Equals(item.SelectedVehicleDescription, item.SelectedVehicleCommonName, StringComparison.OrdinalIgnoreCase))
                                        {
                                            <p class="vehicle-card__desc">@item.SelectedVehicleDescription</p>
                                        }

                                        <ul class="vehicle-specs">
                                            <li>
                                                <span>رنگ بدنه</span>
                                                <strong>@Display(item.BodyColor)</strong>
                                            </li>
                                            <li>
                                                <span>سیستم سوخت</span>
                                                <strong>@Display(item.FullSystem)</strong>
                                            </li>
                                            <li>
                                                <span>شماره موتور</span>
                                                <strong class="ltr">@Display(item.MotorNumber)</strong>
                                            </li>
                                            @if (!string.IsNullOrWhiteSpace(item.VinNumber))
                                            {
                                                <li>
                                                    <span>شماره شاسی</span>
                                                    <strong class="ltr">@item.VinNumber</strong>
                                                </li>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(item.NationalCode))
                                            {
                                                <li>
                                                    <span>کد ملی</span>
                                                    <strong class="ltr">@item.NationalCode</strong>
                                                </li>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(item.Mobile))
                                            {
                                                <li>
                                                    <span>موبایل</span>
                                                    <strong class="ltr">@item.Mobile</strong>
                                                </li>
                                            }
                                        </ul>

                                        <div class="d-flex gap-2">
                                            <NavLink class="btn btn-outline-primary btn-sm">
                                                مشاهده جزئیات
                                            </NavLink>

                                            @if (!item.IsDefault)
                                            {
                                                <NavLink class="btn btn-outline-primary btn-sm">
                                                    پیش فرض
                                                </NavLink>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<VehicleModelDto> Model = new();
    private bool isLoading;
    private readonly Dictionary<int, OrbitState> orbits = new();

    protected override async Task OnInitializedAsync()
    {
        await GetAllSubscriberVehicleAsync();
    }

    async Task GetAllSubscriberVehicleAsync()
    {
        isLoading = true;
        var result = await vehicleService.GetSubscriberVehicleAsync();

        if (result.StatusCode == (int)HttpStatusCode.Unauthorized)
            Navigation.NavigateTo("/login");


        else if (result.Succeeded)
        {
            Model = result.Data ?? new();
        }

        else
        {

        }

        isLoading = false;
    }

    private OrbitState GetOrbit(int id)
    {
        if (!orbits.TryGetValue(id, out var state))
        {
            state = new OrbitState();
            orbits[id] = state;
        }

        return state;
    }

    private static string OrbitStyle(OrbitState orbit)
        => $"--yaw: {orbit.Yaw.ToString(System.Globalization.CultureInfo.InvariantCulture)}deg;";

    private void OnOrbitDown(int id, PointerEventArgs e)
    {
        var orbit = GetOrbit(id);
        orbit.Dragging = true;
        orbit.LastX = e.ClientX;
    }

    private void OnOrbitMove(int id, PointerEventArgs e)
    {
        var orbit = GetOrbit(id);
        if (!orbit.Dragging)
        {
            return;
        }

        orbit.Yaw += (float)(e.ClientX - orbit.LastX) * 0.45f;
        orbit.LastX = e.ClientX;
    }

    private void OnOrbitUp(int id)
    {
        GetOrbit(id).Dragging = false;
    }

    private void OnImageError(int id)
    {
        var orbit = GetOrbit(id);
        if (orbit.ImageFailed)
        {
            return;
        }

        orbit.ImageFailed = true;
    }

    private string GetVehicleImage(VehicleModelDto item)
    {
        return "img/vehicles/toyota-rav4.png";
    }

    private static string Display(string? value)
        => string.IsNullOrWhiteSpace(value) ? "—" : value;

    private sealed class OrbitState
    {
        public float Yaw;
        public bool Dragging;
        public double LastX;
        public bool ImageFailed;
    }
}
