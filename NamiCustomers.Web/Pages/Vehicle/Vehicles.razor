@page "/vehicle"

@inject IVehicleService vehicleService
@inject NavigationManager Navigation

<PageTitle> خودروهای من | نامی خودرو</PageTitle>
@if (isLoading)
{
    <div class="loader-container">
        <MudProgressCircular Rounded="true" Size="MudBlazor.Size.Medium" StrokeWidth="5" Style="color: #ffffff;" Indeterminate="true" />
    </div>
}

else
{

    <div class="page-content-wrapper py-3">
        <div class="shop-pagination pb-3">
            <div class="container">
                <div class="card">
                    <div class="card-body p-2">
                        <div class="d-flex align-items-center justify-content-between">
                            <small class="ms-1">لیست خودروها</small>
                            <NavLink href="/add/vehicle" class="btn m-1 btn-primary btn-sm">
                                <i class="bi bi-plus"></i>
                                افزودن خودرو
                            </NavLink>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Top Products-->
        <div class="top-products-area product-list-wrap">
            <div class="container">
                <div class="row g-3">
                    <!-- Single Top Product Card Start -->
                    @foreach (var item in Model)
                    {
                        <div class="col-12">
                            <div class="card single-product-card">
                                <div class="card-body">
                                    <div class="d-flex align-items-start">

                                        <div class="card-side-img">
                                            <NavLink class="product-thumbnail d-block">
                                                <img class="rounded">
                                            </NavLink>
                                        </div>

                                        <div class="flex-grow-1 px-4 py-2">

                                            <div class="d-flex align-items-center gap-2 mb-2">
                                                <p class="product-title mb-0">@item.VinNumber</p>

                                                <span class="badge bg-primary" style="margin-top: 8px;">
                                                    @item.ProductYear
                                                </span>
                                            </div>

                                            <div class="d-flex gap-2">
                                                <NavLink class="btn btn-outline-primary btn-sm">
                                                    مشاهده جزئیات
                                                </NavLink>

                                                @if (!item.IsDefault)
                                                {
                                                    <NavLink class="btn btn-outline-primary btn-sm">
                                                        پیش فرض
                                                    </NavLink>
                                                }
                                            </div>

                                        </div>

                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                    <!-- Single Top Product Card END-->

                </div>
            </div>
        </div>

        @* <!-- Pagination-->
    <div class="shop-pagination pt-3">
        <div class="container">
            <div class="card">
                <div class="card-body py-3">
                    <nav aria-label="Page navigation example">
                        <ul class="pagination pagination-two justify-content-center">
                            <li class="page-item">
                                < class="page-link" href="#" aria-label="Previous">
                                    <i class="bi bi-chevron-right"></i>
                                </>
                            </li>

                            <li class="page-item active">
                                <a class="page-link" style="color:#000000 !important;" href="#">1</a>
                            </li>

                            <li class="page-item">
                                <a class="page-link" href="#" aria-label="Next">
                                    <i class="bi bi-chevron-left"></i>
                                </a>
                            </li>
                        </ul>
                    </nav>
                </div>
            </div>
        </div>
    </div> *@
    </div>
}

@code {
    private List<VehicleModelDto> Model = new();
    private bool isLoading;

    protected override async Task OnInitializedAsync()
    {
        await GetAllSubscriberVehicleAsync();
    }

    async Task GetAllSubscriberVehicleAsync()
    {
        isLoading = true;
        var result = await vehicleService.GetSubscriberVehicleAsync();

        if (result.StatusCode == (int)HttpStatusCode.Unauthorized)
            Navigation.NavigateTo("/login");


        else if (result.Succeeded)
        {
            Model = result.Data;
        }

        else
        {

        }

        isLoading = false;
    }
}
