@using NamiCustomers.MVC.Services
@model BookingTurnResponse
@{
    ViewData["Title"] = "Index";
}

<br />

<div class="container direction-rtl">
    <div class="card">
        <div class="card-body p-2">
            <div class="d-flex align-items-center justify-content-between">
                <small class="ms-1">نوبت دهی </small>
                <form action="#">
                    <a title="بازگشت" href="/"> <i class="bi bi-arrow-left-short" style="font-size:2rem !important;line-height:1"></i></a>

                </form>
            </div>
        </div>
    </div>
</div>
<br />


<div class="container">
    <div class="card " style="background-color:var(--dark-secondary) !important;">
        <div class="card-body">
            @* <form action="Index"> *@
            <form id="refreshForm">


                <div id="basicwizard" class="colorful-tab">


                    <ul class="nav nav-pills bg-light nav-justified form-wizard-header mb-4">
                        <li class="nav-item">
                            <a href="#Start" data-bs-toggle="tab" data-toggle="tab" class="nav-link rounded-0 pt-2 pb-2 active">
                                <i class="mdi mdi-account-circle me-1"></i>
                                <span class="d-none d-sm-inline">شروع</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a href="#creative" data-bs-toggle="tab" data-toggle="tab" class="nav-link rounded-0 pt-2 pb-2">
                                <i class="mdi mdi-face-profile me-1"></i>
                                <span class="d-none d-sm-inline">انتخاب نوبت</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a href="#modern" data-bs-toggle="tab" data-toggle="tab" class="nav-link rounded-0 pt-2 pb-2">
                                <i class="mdi mdi-face-profile me-1"></i>
                                <span class="d-none d-sm-inline"> بررسی نهایی</span>
                            </a>
                        </li>



                        <li class="nav-item">
                            <a href="#latest" data-bs-toggle="tab" data-toggle="tab" class="nav-link rounded-0 pt-2 pb-2">
                                <i class="mdi mdi-checkbox-marked-circle-outline me-1"></i>
                                <span class="d-none d-sm-inline">کد رهگیری</span>
                            </a>
                        </li>
                    </ul>





                    <div class="tab-content shadow-sm p-3" id="affanTab3Content">

                        <div class="tab-pane fade show active " id="Start" role="tabpanel" aria-labelledby="Start-tab">
                            <h6 class="text-white">
                                راهنمایی و شروع
                            </h6>
                            <p class="mb-0 text-white" style="text-align:justify">
                                به سیستم نوبت دهی مراکز خدمات پس از فروش شرکت نامی خودرو پیشرو خوش آمدید. در این قسمت شما می توانید براساس خدمت مورد نظر خود نسبت به انتخاب نمایندگی خدمات پس از فروش سرویس دهنده خدمت و همچنین زمان انجام خدمات اقدام نمایید. برای ثبت نوبت در سامانه نوبت دهی شرکت نامی خودور پیشرو، لازم است اطلاعات خودرو و اطلاعات مالک یا آورنده خودرو را در سیستم ثبت نمایید. در پایان فرآیند نوبت دهی، سیستم برای شما کد رهگیری تولید نموده و آن را برای شما پیامک خواهد کرد. که باید در هنگام مراجعه به مرکز ارائه کننده سرویس کد پیگیری مربوطه را ارائه نمایید
                            </p>
                            <br />
                            <h6>
                                مشتری محترم لطفا به نکات زیر توجه فرمایید :
                            </h6>
                            <br />
                            <p class="mb-0 text-white" style="text-align:justify">
                                1- خواهشمند است قبل از تحویل خودرو به تعمیرگاه، نسبت به خارج نمودن لوازم شخصی خود اقدام نمایید. تعمیرگاه هیچ گونه مسئولیتی در قبال وسایل شخصی شما نخواهد داشت .

                            </p>
                            <p class="mb-0 text-white" style="text-align:justify">
                                2-جهت رویت بهتر بدنه و جلوگیری از مشكلات آتی، خواهشمند است ترتیبی اتخاذ فرمایید تا در هنگام تحویل خودرو به تعمیرگاه، خودرو تمیز و فاقد هرگونه آلودگی بوده تا امكان شناسایی ایرادات و خط و خش بدنه میسر باشد .

                            </p>
                            <p class="mb-0 text-white" style="text-align:justify">
                                3-جهت پذیرش و جلوگیری از آسیب احتمالی به سیستم سوخت رسانی خودرو، می بایست قبل از تحویل خودرو به تعمیرگاه حداقل 10 لیتر بنزین داخل مخزن سوخت موجود باشد .

                            </p>
                            <p class="mb-0 text-white" style="text-align:justify">
                                4-زمان احتمالی تحویل خودرو، متناسب با نوع سرویس درخواستی و پس از کارشناسی انجام شده توسط کارشناس تعمیرگاه در هنگام پذیرش حضوری از طریق مشاور سرویس به شما اعلام خواهد شد .

                            </p>
                            <p class="mb-0 text-white" style="text-align:justify">
                                5-ارائه کارت شناسایی خودرو و همچنین کارت شناسایی آورنده و یا مالک درهنگام پذیرش و ترخیص الزامی می باشد .

                            </p>
                            <p class="mb-0 text-white" style="text-align:justify">
                                6-در صورت محرز شدن مغایرت بین نوع سرویس انتخابی مشتری در نوبت دهی اینترنتی با نیاز واقعی خودرو در زمان مراجعه، شرکت مسئولیتی در قبال پذیرش خودرو در تاریخ اخذ نوبت نخواهد داشت و نسبت به نوبت دهی مجدد برای مشتری اقدام خواهد شد .
                                .
                            </p>

                        </div>
                        <div class="tab-pane fade " id="creative" role="tabpanel" aria-labelledby="creative-tab">
                            <div class="form-group">
                                <label class="form-label">استان</label>

                                <select onchange="refresh()" asp-for="@Model.SubCountryId" asp-items="@Model.SubCountries" class="form-select form-control-clicked"></select>
                            </div>
                            <div class="form-group">
                                <label class="form-label">شهر</label>

                                <select onchange="refresh()" asp-for="@Model.CityId" asp-items="@Model.Cities" class="form-select form-control-clicked"></select>
                            </div>

                            <div class="form-group">
                                <label class="form-label">عاملیت</label>

                                <select onchange="refresh()" asp-for="@Model.DealerId" asp-items="@Model.Dealers" class="form-select form-control-clicked"></select>
                            </div>
                            <div class="form-group">
                                <label class="form-label">شعبه</label>

                                <select onchange="refresh()" asp-for="@Model.BranchId" asp-items="@Model.Branches" class="form-select form-control-clicked"></select>
                            </div>
                            <div class="form-group">
                                <label class="form-label">نوع خدمت</label>

                                <select onchange="refresh()" asp-for="@Model.ServerGroupId" asp-items="@Model.ServerGroups" class="form-select form-control-clicked"></select>
                            </div>

                            <div class="form-group">
                                <label class="form-label">تاریخ</label>

                                <select onchange="refresh()" asp-for="@Model.ServerGroupDateId" asp-items="@Model.ServerGroupDates" class="form-select form-control-clicked"></select>
                            </div>

                            <div class="form-group">
                                <label class="form-label">ساعت</label>

                                <select onchange="setFinalConfirm()" asp-for="@Model.ServerGroupTimeId" asp-items="@Model.ServerGroupTimes" class="form-select form-control-clicked"></select>
                            </div>

                            <div class="form-group">
                                <label class="form-label"> کیلومتر</label>
                                <input onchange="setFinalConfirm()" min="1" class="form-control form-control-clicked" asp-for="@Model.Kilometer" placeholder="کارکرد (کیلومتر)" type="number">
                            </div>

                            <div class="form-group">
                                <label class="form-label"> توضیحات</label>
                                <textarea  class="form-control form-control-clicked" asp-for="@Model.Description">
                                    </textarea>
                            </div>


                            <button name="action" class="btnrefresh" type="submit" style="display:none;"></button>

                        </div>


                        <div class="tab-pane fade" id="modern" role="tabpanel" aria-labelledby="modern-tab">

                            <p id="lblSubCountryId"></p>
                            <p id="lblCityId"></p>
                            <p id="lblDealerId"></p>
                            <p id="lblBranchId"></p>
                            <p id="lblServerGroupId"></p>
                            <p id="lblServerGroupDateId"></p>
                            <p id="lblServerGroupTimeId"></p>
                            <p id="lblKilometer"></p>
                            <p id="lblDescription"></p>


                            <button name="action" class="insertbooking btn btn-primary" type="submit">ثبت</button>
                        </div>
                        <div class="tab-pane fade " id="latest" role="tabpanel" aria-labelledby="latest-tab">
                            <div id="insertresult">
                            </div>
                        </div>
                        <hr />
                        <ul class="list-inline wizard mb-0">



                            <li class="next list-inline-item">
                                <a id="btnNext" href="javascript: void(0);" class="btn btn-secondary">بعدی</a>
                            </li>
                            <li class="previous list-inline-item float-end">
                                <a href="javascript: void(0);" class="btn btn-secondary">قبلی</a>
                            </li>
                        </ul>
                    </div>
                </div>

            </form>

        </div>
    </div>
</div>

@section Scripts {
    <script src="~/sitetmeplate/js/jquery.bootstrap.wizard.min.js"></script>

    <script>
        function refresh()
           {
              setFinalConfirm();
              $('.btnrefresh').click();
           }
            function setFinalConfirm(){
                            $('#lblSubCountryId').text('').text($('#SubCountryId option:selected').text());
                            $('#lblCityId').text('').text($('#CityId option:selected').text());
                            $('#lblDealerId').text('').text($('#DealerId option:selected').text());
                            $('#lblBranchId').text('').text($('#BranchId option:selected').text());
                            $('#lblServerGroupId').text('').text($('#ServerGroupId option:selected').text());
                            $('#lblServerGroupDateId').text('').text($('#ServerGroupDateId option:selected').text());
                            $('#lblServerGroupTimeId').text('').text($('#ServerGroupTimeId option:selected').text());
                            $('#lblKilometer').text('').text($('#Kilometer').val());
                            $('#lblDescription').text('').text($('#Description').val());
            }



           $(document).ready(function () {

               $("#basicwizard").bootstrapWizard();

                      // جلوگیری از ارسال پیش‌فرض فرم
           $('#refreshForm').on('submit', function(e) {
               e.preventDefault();
           });


               $('.insertbooking').on('click', function (event) {

                   //  Prevent the default form submission (which causes the reload)
                   event.preventDefault();

                   var emptyGuid='00000000-0000-0000-0000-000000000000';
                   if($('#SubCountryId option:selected').val()===emptyGuid)
                   {
                       showError($('#SubCountryId option:selected').text());
                       return;
                   }
                   if($('#CityId option:selected').val()===emptyGuid)
                   {
                        showError($('#CityId option:selected').text());
                         return;
                   }
                   if($('#DealerId option:selected').val()===emptyGuid)
                   {
                        showError($('#DealerId option:selected').text());
                         return;
                   }
                   if($('#BranchId option:selected').val()===emptyGuid)
                   {
                        showError($('#BranchId option:selected').text());
                         return;
                   }
                   if($('#ServerGroupId option:selected').val()===emptyGuid)
                   {
                        showError($('#ServerGroupId option:selected').text());
                         return;
                   }
                   if($('#ServerGroupDateId option:selected').val()===emptyGuid)
                   {
                        showError($('#ServerGroupDateId option:selected').text());
                         return;
                   }
                   if($('#ServerGroupTimeId option:selected').val()===emptyGuid)
                   {
                        showError($('#ServerGroupTimeId option:selected').text());
                         return;
                   }
                    if($('#Kilometer').val()<=0)
                   {
                        showError('کیلومتر وارد شده اشتباه است');
                         return;
                   }
                   if($('#Kilometer').val()<=0)
                   {
                        showError('کیلومتر وارد شده اشتباه است');
                         return;
                   }

                        var formData = $('#refreshForm').serialize();
                   $.ajax({
                       url: '@Url.Action("Register", "Booking")',
                       type: 'POST',
                          data:formData,
                       success: function (result) {

                           console.log(result);
                        if(result.returnKey==null){
                         showError(result.message);
                        }else
                        {
                        $('#insertresult').html('').append("<p>"+result.returnKey+"</p>")
                        $('#btnNext').click();
                        }


                       },
                       error: function (xhr, status, error) {

                           console.error("An error occurred:", error);
                       }
                   });
               });

               $('.btnrefresh').click(function (event) {
                   //  Prevent the default form submission (which causes the reload)
                   event.preventDefault();
                      var formData = $('#refreshForm').serialize();

                   $.ajax({
                       url: '@Url.Action("Refresh", "Booking")',
                       type: 'POST',
                          data: formData, // Serializes the form data
                       success: function (result) {


                           const responseData=result.data;

                           const cities=responseData.cities;
                           const $cities = $('#CityId');
                           $cities.empty();
                           $.each(cities, function(index, item) {
                           var seleted=item.selected?'selected':'';
                           $cities.append("<option "+seleted+" value='"+item.value+"'>"+item.text+"</option>");
                           });


                           const dealers=responseData.dealers;
                           const $dealers = $('#DealerId');
                           $dealers.empty();
                           $.each(dealers, function(index, item) {
                           var seleted=item.selected?'selected':'';
                           $dealers.append("<option "+seleted+" value='"+item.value+"'>"+item.text+"</option>");
                           });

                           const branchs=responseData.branches;
                           const $branchs = $('#BranchId');
                           $branchs.empty();
                           $.each(branchs, function(index, item) {
                           var seleted=item.selected?'selected':'';
                           $branchs.append("<option "+seleted+" value='"+item.value+"'>"+item.text+"</option>");
                           });

                           const servergroups=responseData.serverGroups;
                           const $servergroups = $('#ServerGroupId');
                           $servergroups.empty();
                           $.each(servergroups, function(index, item) {
                           var seleted=item.selected?'selected':'';
                           $servergroups.append("<option "+seleted+" value='"+item.value+"'>"+item.text+"</option>");
                           });

                           const serverGroupDates=responseData.serverGroupDates;
                           const $serverGroupDates = $('#ServerGroupDateId');
                           $serverGroupDates.empty();
                           $.each(serverGroupDates, function(index, item) {
                           var seleted=item.selected?'selected':'';
                           $serverGroupDates.append("<option "+seleted+" value='"+item.value+"'>"+item.text+"</option>");
                           });

                           const serverGroupTimes=responseData.serverGroupTimes;
                           const $serverGroupTimes = $('#ServerGroupTimeId');
                           $serverGroupTimes.empty();
                           $.each(serverGroupTimes, function(index, item) {
                           var seleted=item.selected?'selected':'';
                           $serverGroupTimes.append("<option "+seleted+" value='"+item.value+"'>"+item.text+"</option>");
                           });







                           console.log("Form submitted successfully!", result);
                           // You can update parts of the page here instead of reloading
                           // For example: $('#resultDiv').html(result);
                       },
                       error: function (xhr, status, error) {

                           console.error("An error occurred:", error);
                       }
                   });
               });




           });

    </script>
}