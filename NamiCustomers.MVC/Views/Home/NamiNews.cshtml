@model IEnumerable<NamiCustomers.Infrastucture.ExternalServices.Nami.Dtos.NamiNewsResponse>

@{
    ViewData["Title"] = "NamiNews";
}

<br />

    <div class="container direction-rtl">
        <div class="card">
            <div class="card-body p-2">
                <div class="d-flex align-items-center justify-content-between">
                    <small class="ms-1"> اخبار و اطلاعیه ها</small>
                    <form action="#">
                        <a title="بازگشت" href="/Home/index"> <i class="bi bi-arrow-left-short" style="font-size:2rem !important;line-height:1"></i></a>

                    </form>
                </div>
            </div>
        </div>
    </div>
    <br />

<div class="container direction-rtl">
    <div class="row g-3">
        @foreach (var item in Model)
        {
            <!-- Single Blog Card -->
            <div class="col-6 col-sm-6 col-md-6">
                <div class="card position-relative shadow-sm">
                    <img class="card-img-top" src="@item.yoast_head_json.og_image[0].url" alt="">
              @*   <span class="badge bg-warning text-dark position-absolute card-badge">Business</span> *@
                <div class="card-body">
                    <span class="badge bg-danger rounded-pill mb-2 d-inline-block">@item.PersianDate</span>
                        <a class="blog-title d-block mb-3 text-dark" href="/Home/NewsDetails/@item.id">

                            @Html.Raw(item.title.rendered.Substring(0, 20))...
                    </a>
                        <a class="btn btn-primary btn-sm" href="/Home/NewsDetails/@item.id">مشاهده</a>
                </div>
            </div>
        </div>
        }


    </div>
</div>
