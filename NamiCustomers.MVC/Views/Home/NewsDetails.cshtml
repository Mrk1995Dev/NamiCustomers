@model NamiCustomers.Infrastucture.ExternalServices.Nami.Dtos.NamiNewsResponse

@{
    ViewData["Title"] = "NewsDetails";
}
<br />

<div class="container direction-rtl">
    <div class="card">
        <div class="card-body p-2">
            <div class="d-flex align-items-center justify-content-between">
                <small class="ms-1"> @Html.DisplayFor(model => model.title.rendered)</small>
                <form action="#">
                    <a title="بازگشت" href="/Home/naminews"> <i class="bi bi-arrow-left-short" style="font-size:2rem !important;line-height:1"></i></a>

                </form>
            </div>
        </div>
    </div>
</div>

<br />

<div class="container direction-rtl">
    <div class="card">
        <div class="card-body p-2">
    <div class="container">
        <div class="pt-3 d-block"></div>

        <div class="blog-details-post-thumbnail position-relative">
            <!-- Post Image -->
                    <img class="w-100 rounded-lg" src="@Model.yoast_head_json.og_image[0].url" alt="">
            <!-- Post Bookmark -->
         @*    <a class="post-bookmark position-absolute card-badge" href="#">
                <i class="bi bi-bookmark"></i>
            </a> *@
        </div>
    </div>

    <div class="blog-description py-3">
        <div class="container">
                    <a class="badge bg-primary mb-2 d-inline-block" target="_blank" href=" @Html.DisplayFor(model => model.link)">مشاهده خبر در وب سایت نامی خودرو</a>
                    <h3 class="mb-3">@Html.DisplayFor(model => model.title.rendered)</h3>

            <div class="d-flex align-items-center mb-4">
                <a class="badge-avater" href="#">
                    <img class="img-circle" src="img/bg-img/user1.png" alt="">
                </a>
                        <span class="ms-2">@Html.DisplayFor(model => model.PersianDate)</span>
            </div>

            <p class="fz-14" style="text-align:justify">
                        @Html.Raw(Model.content.rendered)
            </p>
           
        </div>
    </div>

