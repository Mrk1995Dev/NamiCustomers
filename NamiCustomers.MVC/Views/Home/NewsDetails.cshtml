@model NamiCustomers.Infrastucture.ExternalServices.Nami.Dtos.NamiNewsResponse

@{
    ViewData["Title"] = "NewsDetails";
}
<br />

<div class="container direction-rtl">
    <div class="card">
        <div class="card-body p-2">
            <div class="d-flex align-items-center justify-content-between">
                <small class="ms-1"> @Html.DisplayFor(model => model.title.rendered)</small>
                <form action="#">
                    <a title="بازگشت" href="/Home/naminews"> <i class="bi bi-arrow-left-short" style="font-size:2rem !important;line-height:1"></i></a>

                </form>
            </div>
        </div>
    </div>
</div>
<br />


<div>
    <h4>NamiNewsResponse</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.id)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.yoast_head_json.og_image[0].url)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.date)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.date)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.PersianDate)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.PersianDate)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.date_gmt)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.date_gmt)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.status)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.status)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.type)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.content.rendered)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.link)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.link)
        </dd>
    </dl>
</div>
 
