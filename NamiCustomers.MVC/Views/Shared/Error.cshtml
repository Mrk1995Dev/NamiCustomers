@using NamiCustomers.Abstractions.Dtos
@inject IHostEnvironment environment
@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}


<h4 class="text-danger">هنگام پردازش درخواست شما خطایی رخ داد.</h4>
@if (User.IsInRole(MyRoles.Subscriber) && environment.IsProduction())
{
    var errorResponse = TempData["ErrorMessage"];
    <ul style="text-decoration:none">
        خطا :

        <li>
            <p>@errorResponse</p>
        </li>

    </ul>
}



@if (User.IsInRole(MyRoles.Admin) || environment.IsDevelopment())
{
    @*   @if (Model.ShowRequestId)
        {
            <p>
                <strong>Request ID:</strong> <code>@Model.RequestId</code>
            </p>
        }
 *@

    @if (Model.Errors.Any())
    {
        <ul style="text-decoration:none">
            خطا :
            @foreach (var error in Model.Errors)
            {
                <li>
                    <p>@error</p>
                </li>
            }

        </ul>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        var errorResponse = TempData["ErrorMessage"];
        <ul style="text-decoration:none">
            خطا :

            <li>
                <p>@errorResponse</p>
            </li>

        </ul>

    }

}
