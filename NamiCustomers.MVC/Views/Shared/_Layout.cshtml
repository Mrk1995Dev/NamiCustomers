<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="description" content="">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <!-- The above 4 meta tags *must* come first in the head; any other head content must come *after* these tags -->

    <meta name="theme-color" content="#0134d4">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black">

    <!-- Title -->
    <title>@ViewData["Title"] - سامانه مشترکین</title>
    <!-- Favicon -->
    <link rel="icon" href="~/SiteTmeplate/img/core-img/favicon.ico">
    <link rel="apple-touch-icon" href="~/SiteTmeplate/img/icons/icon-96x96.png">
    <link rel="apple-touch-icon" sizes="152x152" href="~/SiteTmeplate/img/icons/icon-152x152.png">
    <link rel="apple-touch-icon" sizes="167x167" href="~/SiteTmeplate/img/icons/icon-167x167.png">
    <link rel="apple-touch-icon" sizes="180x180" href="~/SiteTmeplate/img/icons/icon-180x180.png">

    <!-- Style CSS -->
    <link rel="stylesheet" href="~/SiteTmeplate/style.css">
    <link href="~/sitetmeplate/css/fontiran.css" rel="stylesheet" />
    <!-- Web App Manifest -->
    @*  <link rel="manifest" href="~/SiteTmeplate/manifest.json"> *@
</head>

<body>
    <!-- Preloader -->
    <div id="preloader">
        <div class="spinner-grow text-primary" role="status">
            <span class="visually-hidden">در حال پردازش لطفا منتظر بمانید...</span>
        </div>
    </div>

    <!-- Internet Connection Status -->
    <div class="internet-connection-status" id="internetStatus"></div>

    <!-- Header Area -->
    <div class="header-area" id="headerArea">
        <div class="container-fluid">
            <!-- Header Content -->
            <div class="header-content header-style-five position-relative d-flex align-items-center justify-content-between">
                <!-- Logo Wrapper -->
                <div class="logo-wrapper">
                    <a href="/">
                        <img src="~/SiteTmeplate/img/core-img/logo.png" alt="">
                    </a>
                </div>
                <div class="setting-wrapper">
                    <div class="setting-trigger-btn" id="settingTriggerBtn">
                        <b>LGBH9VEAXPY770511 </b>
                        <i class="bi bi-caret-down-fill"></i>
                        
                    </div>
                </div>
                <!-- Navbar Toggler -->
                <div class="navbar--toggler" id="affanNavbarToggler" data-bs-toggle="offcanvas" data-bs-target="#NamioffCanvas"
                     aria-controls="NamioffCanvas">
                    <span class="d-block"></span>
                    <span class="d-block"></span>
                    <span class="d-block"></span>
                </div>
            </div>
        </div>
    </div>


   
    <!-- # Sidenav Right -->

    <div class="offcanvas offcanvas-end" id="NamioffCanvas" data-bs-scroll="true" tabindex="-1" aria-labelledby="affanOffcanvsLabel">

        <button class="btn-close btn-close-white text-reset" type="button" data-bs-dismiss="offcanvas" aria-label="Close"></button>

        <div class="offcanvas-body p-0">
            <div class="sidenav-wrapper">
                <!-- Sidenav Profile -->
                <div class="sidenav-profile bg-gradient">
                    <div class="sidenav-style1"></div>

                    <!-- User Thumbnail -->
                    <div class="user-profile">
                        <img src="img/bg-img/2.jpg" alt="">
                    </div>

                    <!-- User Info -->
                    <div class="user-info">
                        <h6 class="user-name mb-0">@User.Claims.FirstOrDefault(c => c.Type == MyClaims.FullName.ToString())?.Value</h6>
                        <span>

                            @{
                                var roles = string.Join(",", User.Claims.Where(c => c.Type == MyClaims.PersianRole.ToString()).Select(c => c.Value).ToList());
                                <i>
                                    @roles
                                </i>

                            }
                        </span>
                    </div>
                </div>

                <!-- Sidenav Nav -->
                <ul class="sidenav-nav ps-0">
                    <li>
                        <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">
                            <i class="bi bi-house-door"></i> خانه
                        </a>
                    </li>
                    <li>
                        <a class="nav-link text-dark" asp-area="" asp-controller="Subscriber" asp-action="Profile">
                            <i class="bi bi-person"></i> پروفایل

                        </a>
                    </li>

                    <li>
                        <a class="nav-link text-dark" asp-area="" asp-controller="Vehicle" asp-action="Index">
                            <i class="bi bi-car-front"></i> خودروهای من

                        </a>
                    </li>
                    @if (User.Identity.IsAuthenticated && User.IsInRole("Admin"))
                    {
                        <li>
                            <a href="#" class="nav-url">
                                <i class="bi bi-cart-check"></i>دسترسی ها
                                <span class="dropdown-icon"><i class="bi bi-chevron-down"></i></span>
                            </a>
                            <ul>
                                <li><a asp-area="admin" asp-controller="roles" asp-action="Index">نقش ها</a></li>
                                <li><a asp-area="admin" asp-controller="users" asp-action="Index">کاربران</a></li>

                            </ul>
                        </li>
                    }

                    <li>
                        <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Contact">
                            <i class="bi bi-telephone"></i>
                            <span>تماس با ما</span>
                        </a>
                    </li>
                    <li>
                        <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="about">
                            <i class="bi bi-card-text"></i> درباره ما
                        </a>
                    </li>
        
                    <li>
                        <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Privacy">
                            <i class="bi bi-shield-check"></i> حریم خصوصی
 </a>
                    </li>

                    <li>
                        <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="">
                            <i class="bi bi-shield-check"></i> قانون و آیین نامه حمایت از  سحقوق مصرف کننده
                        </a>
                    </li>

                    <li>
                        <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="">
                            <i class="bi bi-shield-check"></i> لیست قطعات و عیوب ایمنی خودرو
                        </a>
                    </li>
                    <li>
                        <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="faq">
                            <i class="bi bi-shield-check"></i> سوالات متداول
                        </a>
                    </li>
                    

                    @if (User.Identity.IsAuthenticated)
                    {

                        if (User.IsInRole("Admin"))
                        {


                            <li>
                                <a class="nav-link text-dark" asp-area="admin" asp-controller="users" asp-action="مدیریت">
                                    <i class="bi bi-gear"></i> مدیریت
                                </a>
                            </li>
                        }

                        @*     <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="Account" asp-action="Logout">خروج</a>
                            </li> *@
                        <li>
                            <a class="nav-link text-dark" asp-area="" asp-controller="Account" asp-action="Logout">
                                <i class="bi bi-box-arrow-right"></i> خروج
                            </a>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            <a class="nav-link text-dark right" asp-area="" asp-controller="Account" asp-action="LoginByMobile">ورود</a>
                        </li>
                    }
                </ul>

                <!-- Social Info -->
                <div class="social-info-wrap">
                    <a href="https://instagram.com/namikhodropishro">
                        <i class="bi bi-instagram"></i>
                    </a>
              
                    <a href="https://www.linkedin.com/company/namikhodro">
                        <i class="bi bi-linkedin"></i>
                    </a>
                </div>

                <!-- Copyright Info -->
                <div class="copyright-info">
                    <p><span id="">1404</span> ©  کپی رایت<a href="#"> شرکت نامی خودرو پیشرو</a></p>
                </div>
            </div>
        </div>
    </div>


    <div class="page-content-wrapper">
        @RenderBody()
        <!-- Welcome Toast -->
        <div class="card setting-popup-card shadow-lg " id="settingCard">
            <div class="card-body">
                <div class="container">
                    <div class="setting-heading d-flex align-items-center justify-content-between mb-3">
                        <p class="mb-0">لیست خودروهای شما</p>
                        <div class="btn-close" id="settingCardClose"></div>
                    </div>
                    <div class="single-plan-check shadow-sm active-effect">
                        <div class="form-check mb-0">
                            <input class="form-check-input" type="radio" name="planChoose" id="Individual">
                            <label class="form-check-label" for="Individual">LGB00000000000511</label>
                        </div>
@*                         <i class="bi bi-person text-primary fz-20 ms-auto"></i>
 *@                    </div>

                    <div class="single-plan-check active shadow-sm active-effect">
                        <div class="form-check mb-0">
                            <input class="form-check-input" type="radio" name="planChoose" id="Team" checked="">
                            <label class="form-check-label" for="Team">LGBH9VEAXPY770511</label>
                        </div>
                     @*    <i class="bi bi-people text-success fz-20 ms-auto"></i> *@
                    </div>

                   @*  <div class="single-setting-panel">
                        <div class="form-check form-switch mb-2">
                            <input class="form-check-input" type="checkbox" id="availabilityStatus" checked="">
                            <label class="form-check-label" for="availabilityStatus">Availability status</label>
                        </div>
                    </div>

                    <div class="single-setting-panel">
                        <div class="form-check form-switch mb-2">
                            <input class="form-check-input" type="checkbox" id="sendMeNotifications" checked="">
                            <label class="form-check-label" for="sendMeNotifications">Send me notifications</label>
                        </div>
                    </div>

                    <div class="single-setting-panel">
                        <div class="form-check form-switch mb-2">
                            <input class="form-check-input" type="checkbox" id="darkSwitch">
                            <label class="form-check-label" for="darkSwitch">Dark mode</label>
                        </div>
                    </div>

                    <div class="single-setting-panel">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" id="rtlSwitch">
                            <label class="form-check-label" for="rtlSwitch">RTL mode</label>
                        </div>
                    </div> *@
                </div>
            </div>
        </div>
    </div>

    <!-- Footer Nav -->
    <div class="footer-nav-area" id="footerNav">
        <div class="container-fluid px-0">
            <!-- Footer Content -->
            <div class="footer-nav position-relative">
                <ul class="h-100 d-flex align-items-center justify-content-between ps-0">
                    <li class="active">
                        <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">
                            <i class="bi bi-house-door"></i>
                            <span>خانه </span>
                        </a>


                    </li>

                    <li>
                        <a class="nav-link text-dark" asp-area="" asp-controller="Subscriber" asp-action="Profile">
                            <i class="bi bi-person"></i>
                            <span>پروفایل</span>
                        </a>
                    </li>

                    <li>
                        <a class="nav-link text-dark" asp-area="" asp-controller="Vehicle" asp-action="Index">
                            <i class="bi bi-car-front"></i>
                            <span>خودروهای من</span>
                        </a>
                    </li>

                    <li>
                        <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Contact">
                            <i class="bi bi-telephone"></i>
                            <span>تماس با ما</span>
                        </a>
                    </li>
                    
                    <li>
                        <a class="nav-link text-dark" asp-area="" asp-controller="Dealer" asp-action="Dealers">
                            <i class="bi bi-geo-alt"></i>
                            <span>لیست عاملیت </span>
                        </a>
                    </li>
                </ul>
            </div>
        </div>
    </div>

    <!-- All JavaScript Files -->
    <script src="~/SiteTmeplate/js/bootstrap.bundle.min.js"></script>
    <script src="~/SiteTmeplate/js/slideToggle.min.js"></script>
    <script src="~/SiteTmeplate/js/internet-status.js"></script>
    <script src="~/SiteTmeplate/js/tiny-slider.js"></script>
    <script src="~/SiteTmeplate/js/venobox.min.js"></script>
    <script src="~/SiteTmeplate/js/countdown.js"></script>
    <script src="~/SiteTmeplate/js/rangeslider.min.js"></script>
    <script src="~/SiteTmeplate/js/vanilla-dataTables.min.js"></script>
    <script src="~/SiteTmeplate/js/index.js"></script>
    <script src="~/SiteTmeplate/js/imagesloaded.pkgd.min.js"></script>
    <script src="~/SiteTmeplate/js/isotope.pkgd.min.js"></script>
    <script src="~/SiteTmeplate/js/dark-rtl.js"></script>
    <script src="~/SiteTmeplate/js/active.js"></script>
    @*    <script src="~/SiteTmeplate/js/pwa.js"></script> *@

    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>