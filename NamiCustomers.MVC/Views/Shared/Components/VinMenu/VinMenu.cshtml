@using NamiCustomers.Abstractions.Dtos.Vehicles

@model List<VehicleModelDto>?
@{
    Layout = null;
}
<div class="container">
    <div class="setting-heading d-flex align-items-center justify-content-between mb-3">
        <p class="mb-0">لیست خودروهای شما</p>
        <div class="btn-close" id="settingCardClose"></div>
    </div>
    @if (Model != null)
    {

        foreach (var item in Model)
        {


            <div class="single-plan-check shadow-sm active-effect">
                <div class="form-check mb-0">
                    <input class="form-check-input" checked="@item.IsDefault" type="radio" name="planChoose" id="Individual">
                    <label class="form-check-label" for="Individual">@item.VinNumber</label>
                    @if (!item.IsDefault)
                    {
                        <a class="btn btn-primary btn-sm" href="/Vehicle/Default/@item.Id">انتخاب</a>
                    }
                </div>
            </div>

        }
    }
</div>