@model IEnumerable<NamiCustomers.Infrastucture.ExternalServices.SevenSoft.Dtos.ReceptionCustomerStatementInformationByReceptionCodeResponse>

@{
    ViewData["Title"] = "ReceptionCustomerStatementInformation";
}

<div class="container">
    <div class="element-heading">
        <h6>اظهارات پذیرش</h6>
    </div>
</div>
<br />

@if (Model == null || !Model.Any())
{
    <div class="container">
        <div class="card" style="border-left:0.5rem solid var(--danger-500) !important">
            <div class="card-body">
                <div class="accordion" id="basicaccordion">
                    <p style="direction:rtl !important">
                        موردی برای نمایش وجود ندارد.
                    </p>
                </div>
            </div>
        </div>
    </div>

}
else
{
    <div class="container">
        <div class="card" style="border-left:0.5rem solid var(--success-500) !important">
            <div class="card-body">
                <div class="accordion" id="basicaccordion">
                    @foreach (var (item, index) in Model.Select((item, index) => (item, index)))
                    {
                        <!-- Single Accordion -->
                        <div class="accordion-item">
                            <div class="accordion-header" id="headingOne">
                                <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#@(index + 1)" aria-expanded="false" aria-controls="@(index + 1)">@(index + 1) ) &nbsp;&nbsp; @* @Html.DisplayNameFor(model => model.PartNo) *@<span style="direction:ltr !important;text-align:right !important">@item.CustomerDescription</span></button>
                            </div>
                            <div class="accordion-collapse collapse" id="@(index + 1)" aria-labelledby="headingOne" data-bs-parent="#basicaccordion" style="">
                                <div class="accordion-body">
                                    <table class="table mb-0">

                                        <tbody>
                                            <tr>
                                                <th> @Html.DisplayNameFor(model => model.DefaultCustomerDescriptionLocalizedName)</th>
                                                <td> @item.DefaultCustomerDescriptionLocalizedName</td>

                                            </tr>
                                            <tr>
                                                <th> @Html.DisplayNameFor(model => model.CustomerStatementsTypeLocalizedName)</th>
                                                <td> @Html.DisplayFor(model => item.CustomerStatementsTypeLocalizedName) </td>

                                            </tr>
                                            <tr>
                                                <th> @Html.DisplayNameFor(model => model.StatementsTypeLocalizedName)</th>
                                                <td> @Html.DisplayFor(model => item.StatementsTypeLocalizedName) </td>

                                            </tr>
                                            <tr>

                                                <th> @Html.DisplayNameFor(model => model.ExpertTheory)</th>
                                                <td> @Html.DisplayFor(model => item.ExpertTheory) </td>
                                            </tr>
                                            <tr>
                                                <th> @Html.DisplayNameFor(model => model.Approved)</th>
                                                <td>
                                                    @if (item.Approved)
                                                    {
                                                        <i class="text-success bi bi-check-lg fz-16"></i>
                                                    }
                                                    else
                                                    {
                                                        <i class="text-danger bi bi-x-lg fz-16"></i>
                                                    }
                                                
                                                </td>

                                            </tr>
                                           
                                            <tr>
                                                <th> @Html.DisplayNameFor(model => model.ReturnReceptionCode)</th>
                                                <td> @Html.DisplayFor(model => item.ReturnReceptionCode) </td>

                                            </tr>
                                          
                                          @*   <tr>
                                                <th> @Html.DisplayNameFor(model => model.CostCenterName)</th>
                                                <td> @Html.DisplayFor(model => item.CostCenterName) </td>
                                            </tr> *@
                                            @* <tr>
                                            <th> گارانتی خودرو فعال است؟</th>

                                            <td><i class="text-success bi bi-check-lg fz-16"></i></td>


                                        </tr> *@

                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    }


                </div>
            </div>
        </div>
    </div>











}

