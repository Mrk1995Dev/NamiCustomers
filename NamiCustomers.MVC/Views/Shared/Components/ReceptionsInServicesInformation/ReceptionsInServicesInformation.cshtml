@model IEnumerable<NamiCustomers.Infrastucture.ExternalServices.SevenSoft.Dtos.ReceptionsInServicesInformationByReceptionCodeResponse>

@{
    ViewData["Title"] = "ReceptionsInServicesInformation";
}


<div class="container">
    <div class="element-heading">
        <h6>خدمات داخل تعمیرگاه</h6>
    </div>
</div>


<br />

@if (Model == null || !Model.Any())
{
    <div class="container">
        <div class="card" style="border-left:0.5rem solid var(--danger-500) !important">
            <div class="card-body">
                <div class="accordion" id="basicaccordion">
                    <p style="direction:rtl !important;text-align: center;">
                        <img src="~/sitetmeplate/img/icon set/png/nodata.png" style="width:40% !important" />
                    </p>

                </div>
            </div>
        </div>
    </div>

}
else
{
<div class="container">
    <div class="card" style="border-left:0.5rem solid var(--warning-500) !important">
        <div class="card-body">
            <div class="accordion" id="basicaccordion">
                @foreach (var (item, index) in Model.Select((item, index) => (item, index)))
                {
                    <!-- Single Accordion -->
                    <div class="accordion-item">
                        <div class="accordion-header" id="headingOne">
                            <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#@item.ServiceCode" aria-expanded="false" aria-controls="@item.ServiceCode">@(index + 1) ) &nbsp;&nbsp; @* @Html.DisplayNameFor(model => model.PartNo) *@<span style="direction:ltr !important;text-align:right !important">@item.ServiceName</span></button>
                        </div>
                        <div class="accordion-collapse collapse" id="@item.ServiceCode" aria-labelledby="headingOne" data-bs-parent="#basicaccordion" style="">
                            <div class="accordion-body">
                                <table class="table mb-0">

                                    <tbody>
                                        <tr>
                                            <th> @Html.DisplayNameFor(model => model.ServiceCode)</th>
                                            <td style="font-family: Inter, sans-serif !important"> @item.ServiceCode</td>

                                        </tr>
                                        <tr>
                                            <th>مدت زمان تعمیر</th>
                                            <td>@Html.DisplayFor(model => item.Time)</td>

                                        </tr>
                                        <tr>
                                            <th> @Html.DisplayNameFor(model => model.Number)</th>
                                            <td> @Html.DisplayFor(model => item.Number) </td>

                                        </tr>
                                        <tr>
                                            <th> @Html.DisplayNameFor(model => model.UnitPrice)</th>
                                            <td> @Html.DisplayFor(model => item.UnitPrice) ریال</td>

                                        </tr>
                                        <tr>

                                            <th> @Html.DisplayNameFor(model => model.TotalPrice)</th>
                                            <td> @Html.DisplayFor(model => item.TotalPrice) ریال</td>
                                        </tr>
                                        <tr>
                                            <th> @Html.DisplayNameFor(model => model.Discount)</th>
                                            <td> @Html.DisplayFor(model => item.Discount) ریال</td>

                                        </tr>
                                        <tr>
                                            <th> مبلغ کل پس از کسر تخفیف	</th>
                                            <td> @((item.TotalPrice - item.Discount).ToString("N0")) ریال</td>

                                        </tr>
                                        <tr>
                                            <th> @Html.DisplayNameFor(model => model.Tax)</th>
                                            <td> @Html.DisplayFor(model => item.Tax) ریال</td>

                                        </tr>
                                        <tr>
                                            <th> جمع کل + مالیات و عوارض	</th>
                                            <td> @(((item.TotalPrice - item.Discount) + item.Tax).ToString("N0")) ریال</td>

                                        </tr>
                                        <tr>
                                            <th> @Html.DisplayNameFor(model => model.CostCenterLocalizedName)</th>
                                            <td> @Html.DisplayFor(model => item.CostCenterLocalizedName) </td>
                                        </tr>
                                        @* <tr>
                                            <th> گارانتی خودرو فعال است؟</th>

                                            <td><i class="text-success bi bi-check-lg fz-16"></i></td>


                                        </tr> *@

                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                }


            </div>
        </div>
    </div>
</div>

}

 

