@model NamiCustomers.Infrastucture.ExternalServices.Nami.Dtos.NamiNewsResponse[]



<div class="testimonial-slide-three-wrapper">
    <div class="testimonial-slide3 testimonial-style3">



        <div class="testimonial-slide-three-wrapper">
            <div class="testimonial-slide3 testimonial-style3">


                <div class="single-testimonial-slide">
                    @foreach (var news in Model)
                    {
                        <div class="text-content">
                            <span class="d-inline-block badge  mb-2" style="border-color:#df0a2a;background-color:#df0a2a">
                                @news.PersianDate
                            </span>
                            <br />

                            <h6 class="mb-2"> @Html.Raw(news.title.rendered)  </h6>
                            <br />
                            <span class="d-block"> @Html.Raw(news.content.rendered.Substring(0, 200)) ... </span>
                            <br />
                            <a class="btn" style="border-color:#df0a2a;background-color:#df0a2a;float:left" href="/Home/NewsDetails/@news.id">
                                مشاهده
                            </a>

                        </div>
                    }

                </div>





                <!-- Single Testimonial Slide -->
                <div class="single-testimonial-slide">
                    <div class="text-content">
                        <span class="d-inline-block badge bg-warning mb-2">
                            <i class="bi bi-star-fill me-1"></i>
                            <i class="bi bi-star-fill me-1"></i>
                            <i class="bi bi-star-fill me-1"></i>
                            <i class="bi bi-star-fill me-1"></i>
                            <i class="bi bi-star-fill"></i>
                        </span>
                        <h6 class="mb-2">تمام متن ها, <br> تست.</h6>
                        <span class="d-block">تست</span>
                    </div>
                </div>

            </div>
        </div>
        }
    </div>

</div>
