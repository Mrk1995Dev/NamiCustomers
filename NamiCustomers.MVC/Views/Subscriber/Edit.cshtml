@model NamiCustomers.Abstractions.Dtos.Subscribers.SubscriberDto

@{
    ViewData["Title"] = "ویرایش پروفایل";
}

<br />

<div class="container direction-rtl">
    <div class="card">
        <div class="card-body p-2">
            <div class="d-flex align-items-center justify-content-between">
                <small class="ms-1">ویرایش پروفایل</small>
                <form action="#">
                    <a title="بازگشت" href="/Subscriber/Profile"> <i class="bi bi-arrow-left-short" style="font-size:2rem !important;line-height:1"></i></a>

                </form>
            </div>
        </div>
    </div>
</div>
<br />




<div class="container">
    <!-- User Meta Data-->
    <div class="card user-data-card">
        <div class="card-body">
          
        <form asp-action="Edit" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group" style="display:none">
                    <label asp-for="Id" class="control-label" style="color: #fff !important;"></label>
                    <input asp-for="Id" class="form-control" style="color: #000 !important;" />
                <span asp-validation-for="Id" class="text-danger"></span>
            </div>
            <div class="form-group">
                    <label asp-for="Name" class="control-label" style="color: #fff !important;"></label>
                    <input asp-for="Name" class="form-control" style="color: #000 !important;" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
                <div class="form-group">
                    <label asp-for="Family" class="control-label" style="color: #fff !important;"></label>
                    <input asp-for="Family" class="form-control" style="color: #000 !important;" />
                    <span asp-validation-for="Family" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Mobile" class="control-label" style="color: #fff !important;"></label>
                    <input asp-for="Mobile" class="form-control" style="color: #000 !important;" />
                    <span asp-validation-for="Mobile" class="text-danger"></span>
                </div>
             
            <div class="form-group">
                    <label asp-for="Phone" class="control-label" style="color: #fff !important;"></label>
                    <input asp-for="Phone" class="form-control" style="color: #000 !important;" />
                    <span asp-validation-for="Phone" class="text-danger"></span>
            </div>
                <div class="form-group">
                    <label asp-for="Address" class="control-label" style="color: #fff !important;"></label>
                    <input asp-for="Address" class="form-control" style="color: #000 !important;" />
                    <span asp-validation-for="Address" class="text-danger"></span>
                </div>
            <div class="form-group">

                   

                    <input type="submit" value="ذخیره" class="btn btn-primary w-100" />
@*                     @Html.ActionLink("بازگشت به پروفایل", "Profile", new { id = Model.Id }, new { @class = "btn btn-outline-secondary ", style = "" })
 *@            </div>
        </form>
        </div>
    </div>
</div>










@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
