@using NamiCustomers.Infrastucture.ExternalServices.SevenSoft.Dtos
@model ResultDto<GetReceptionsInformationByVinNumberResponse[]>
@{
    ViewData["Title"] = "ReceptionsInformationByVinNumber";
}

<br />

<div class="container direction-rtl">
    <div class="card">
        <div class="card-body p-2">
            <div class="d-flex align-items-center justify-content-between">
                <small class="ms-1">سوابق تعمیراتی </small>
                <form action="#">
                    @if (Model.Data is   null)
                    {
                        <a class="btn m-1 btn-primary btn-sm" href="/Vehicle/ChassisInformationByVinNumber">  <i class="bi bi-plus"></i> افزودن خودرو</a>
                    }
  <a title="بازگشت" href="/"> <i class="bi bi-arrow-left-short" style="font-size:2rem !important;line-height:1"></i></a>

                </form>
            </div>
        </div>
    </div>
</div>
<br />
<div class="container direction-rtl">
    @if (Model.Data is not null)
    {
        foreach (var item in Model.Data)
        {
            <div class="cart-wrapper-area">


                <div class="cart-table card mb-3">
                    <div class="table-responsive card-body">
                        <table class="table mb-0">
                            <thead class="thead-light">
                                <tr style="text-align:center">
                                    <th colspan="2">تاریخ پذیرش   @Html.DisplayFor(modelItem => item.StrRecDate)</th>


                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <th>    @Html.DisplayNameFor(model => item.ReceptionCode)</th>
                                    <td>   @Html.DisplayFor(modelItem => item.ReceptionCode)</td>

                                </tr>
                                <tr>
                                    <th>    @Html.DisplayNameFor(model => item.DealerName) -</th>
                                    <td>   @Html.DisplayFor(modelItem => item.DealerName)-  @Html.DisplayFor(modelItem => item.BranchName) ( @Html.DisplayFor(modelItem => item.DealerNo)- @Html.DisplayFor(modelItem => item.BranchNo))</td>

                                </tr>
                                @* <tr>
                                <th>    @Html.DisplayNameFor(model => model.ReceptionStateOrder)</th>
                                <td>   @Html.DisplayFor(modelItem => item.ReceptionStateOrder)</td>

                            </tr> *@
                                <tr>
                                    <th>    @Html.DisplayNameFor(model => item.ReceptionType)</th>
                                    <td>   @Html.DisplayFor(modelItem => item.ReceptionType)</td>

                                </tr>
                                <tr>
                                    <th>    @Html.DisplayNameFor(model => item.ReceptionStatus)</th>
                                    <td>   @Html.DisplayFor(modelItem => item.ReceptionStatus)</td>

                                </tr>
                                <tr>
                                    <th>    @Html.DisplayNameFor(model => item.RecKilometer)</th>
                                    <td> @string.Format("{0:#,##0}", item.RecKilometer)  کیلومتر </td>

                                </tr>
                                <tr>
                                    <th>    @Html.DisplayNameFor(model => item.EstimatedDeliver)</th>
                                    <td>   @Html.DisplayFor(modelItem => item.StrEstimatedDeliverDate) - @Html.DisplayFor(modelItem => item.StrEstimatedDeliverTime)</td>

                                </tr>
                                <tr>
                                    <th>    @Html.DisplayNameFor(model => item.ReceptionControlDate)</th>
                                    <td>   @Html.DisplayFor(modelItem => item.StrReceptionControlDate) - @Html.DisplayFor(modelItem => item.StrReceptionControlTime)</td>
                                </tr>
                                <tr>
                                    <th>    @Html.DisplayNameFor(model => item.InvoiceDate)</th>
                                    <td>   @Html.DisplayFor(modelItem => item.StrInvoiceDate) - @Html.DisplayFor(modelItem => item.StrInvoiceTime)</td>

                                </tr>
                                <tr>
                                    <th>    @Html.DisplayNameFor(model => item.EndAmount)</th>
                                    <td> @string.Format("{0:#,##0}", item.EndAmount)  ریال </td>

                                </tr>
                                <tr>
                                    <th>    @Html.DisplayNameFor(model => item.FuelStatusLocalizedName)</th>
                                    <td>   @Html.DisplayFor(modelItem => item.FuelStatusLocalizedName)</td>

                                </tr>
                                <tr>
                                    <th> @Html.DisplayNameFor(model => item.WarrantyStatus)</th>

                                    <td>   @Html.DisplayFor(modelItem => item.WarrantyStatus)</td>
                                </tr>

                            </tbody>
                        </table>
                    </div>

                    <div class="card-body border-top">
                        <div class="apply-coupon">
                            @*  <h6 class="mb-0">Have a coupon?</h6>
                        <p class="mb-2">Enter your coupon code here &amp; get awesome discounts!</p> *@
                            <!-- Coupon Form -->
                            <div class="coupon-form">
                                <form action="#">
                                    @*      <div class="form-group">
                                    <div class="input-group">
                                        <input class="form-control input-group-text text-start form-control-clicked" type="text" placeholder="OFFER30">
                                        <button class="btn btn-primary" type="submit">Apply</button>
                                    </div>
                                </div> *@
                                    <!-- Checkout -->
                                    <a class="btn btn-primary w-100 mt-3" href="~/Reception/InformationOfReception?ReceptionCode=@item.ReceptionCode">مشاهده لیست خدمات قطعات </a>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    }
</div>



