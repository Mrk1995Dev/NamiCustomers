
@using NamiCustomers.MVC.Models.Account
@model LoginDto

@{
    ViewData["Title"] = "Login";
    Layout = null;
}
<!-- App css -->
 
<link href="~/css/theme/default/bootstrap-rtl.min.css" rel="stylesheet" type="text/css" id="bs-default-stylesheet" />
<link href="~/css/theme/default/app-rtl.min.css" rel="stylesheet" type="text/css" id="app-default-stylesheet" />


 
<div class="auth-fluid" dir="rtl">
    <!--Auth fluid left content -->
    <div class="auth-fluid-form-box">
        <div class="align-items-center d-flex h-100">
            <div class="card-body">

                <!-- Logo -->
                <div class="auth-brand text-center text-lg-start">
                    <div class="auth-logo">
                        <a href="index.html" class="logo logo-dark text-center">
                            <span class="logo-lg">
                                <img src="~/css/theme/images/logo-dark.png" alt="" height="22">
                            </span>
                        </a>

                        <a href="index.html" class="logo logo-light text-center">
                            <span class="logo-lg">
                                <img src="~/css/theme/images/logo-dark.png" alt="" height="22">
                            </span>
                        </a>
                    </div>
                </div>

                <ul class="nav nav-tabs nav-bordered">
                    <li class="nav-item">
                        <a href="#tab-login" data-bs-toggle="tab" aria-expanded="false" class="nav-link active">
                           ورود
                        </a>
                    </li>
                   
                </ul>
                <div class="tab-content">
                    <div class="tab-pane show active" id="tab-login">
                        <p class="text-muted mb-3">آدرس ایمیل و رمز عبور خود را برای دسترسی به حساب وارد کنید.</p>

                      

                        <form asp-action="Login">
                            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                            <div class="form-group">
                                <label asp-for="UserName" class="control-label"></label>
                                <input asp-for="UserName" class="form-control" />
                                <span asp-validation-for="UserName" class="text-danger"></span>
                            </div>
                            <div class="form-group">
                                <label asp-for="Password" class="control-label"></label>
                                <input asp-for="Password" class="form-control" />
                                <span asp-validation-for="Password" class="text-danger"></span>
                            </div>

                             
                            <input asp-for="ReturnUrl" type="hidden" class="form-control" />

                            <br />
                            <div class="form-group">
                                <input type="submit" value="ورود" class="btn btn-success" />
                                |
                                @Html.ActionLink("فراموشی رمز عبور", "ForgotPassword", "Account")

                               
                            </div>

                        </form>
                    </div>
                     
                </div>

                

            </div>
            <!-- end .card-body -->
        </div>
        <!-- end .align-items-center.d-flex.h-100-->
    </div>
</div>




@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
