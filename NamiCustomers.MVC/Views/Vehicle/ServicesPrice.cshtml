@model NamiCustomers.Infrastucture.ExternalServices.SevenSoft.Dtos.ServicesPriceRequest

@{
    ViewData["Title"] = "ServicesPrice";
}

<h4>استعلام بهای قطعات</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="ServicesPriceList" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            @*  <div class="form-group">
                <label asp-for="VehicleModelId" class="control-label"></label>
                <input asp-for="VehicleModelId" class="form-control" />
                <span asp-validation-for="VehicleModelId" class="text-danger"></span>
            </div> *@
            <div class="form-group">
                <label asp-for="ServiceCode" class="control-label"></label>
                <input asp-for="ServiceCode" class="form-control" />
                <span asp-validation-for="ServiceCode" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="ServiceName" class="control-label"></label>
                <input asp-for="ServiceName" class="form-control" />
                <span asp-validation-for="ServiceName" class="text-danger"></span>
            </div>
            @*             <div class="form-group">
                <label asp-for="ChassisVinNumber" class="control-label"></label>
                <input asp-for="ChassisVinNumber" class="form-control" />
                <span asp-validation-for="ChassisVinNumber" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="NationalCodeOrEconomicCode" class="control-label"></label>
                <input asp-for="NationalCodeOrEconomicCode" class="form-control" />
                <span asp-validation-for="NationalCodeOrEconomicCode" class="text-danger"></span>
            </div> *@
            <div class="form-group">
                <label asp-for="DealerId" class="control-label"></label>
                <select id="DealerDropdown" asp-for="@Model.DealerId" asp-items="@ViewBag.Dealers" class="form-select form-control-clicked"></select>
                <span asp-validation-for="DealerId" class="text-DealerId"></span>
            </div>
            <div class="form-group">
                <label asp-for="BranchId" class="control-label"></label>
                <select id="BranchDropdown" asp-for="@Model.BranchId"  class="form-select form-control-clicked"></select>
                <span asp-validation-for="BranchId" class="text-danger"></span>
            </div>

           
            <div class="form-group">
                <input  type="submit" value="جستجو" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>


@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        function refresh()
           {
               location.reload();
           }


    </script>


    <script>
        $(document).ready(function () {
            $('#DealerDropdown').change(function () {
                var DealerId = $(this).val();
                var BranchDropdown = $('#BranchDropdown');

                // Clear existing options
                BranchDropdown.empty();
                BranchDropdown.append('<option value="">-- Select Branch --</option>');

                if (DealerId) {
                    $.getJSON('/Vehicle/GetBranchesByDealer', { dealerId: DealerId }, function (data) {
                        if (data && data.length > 0) {
                            $.each(data, function (index, item) {
                                BranchDropdown.append($('<option></option>').val(item.value).text(item.text));
                            });
                        }
                    });
                }
            });
        });
    </script>
}
