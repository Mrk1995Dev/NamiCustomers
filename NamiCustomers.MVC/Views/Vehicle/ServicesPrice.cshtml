</div>












@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        function refresh()
           {
               location.reload();
           }


    </script>


    <script>
        $(document).ready(function () {
            $('#DealerDropdown').change(function () {
                var DealerId = $(this).val();
                var BranchDropdown = $('#BranchDropdown');

                // Clear existing options
                BranchDropdown.empty();
                BranchDropdown.append('<option value="">-- Select Branch --</option>');

                if (DealerId) {
                    $.getJSON('/Vehicle/GetBranchesByDealer', { dealerId: DealerId }, function (data) {
                        if (data && data.length > 0) {
                            $.each(data, function (index, item) {
                                BranchDropdown.append($('<option></option>').val(item.value).text(item.text));
                            });
                        }
                    });
                }
            });
        });
    </script>
}
