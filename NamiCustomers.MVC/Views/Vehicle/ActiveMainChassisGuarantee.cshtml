                        </dd>
                        <dt class="col-sm-2">
                            @Html.DisplayNameFor(model => model.StartMileage)
                        </dt>
                        <dd class="col-sm-10">
                            @Html.DisplayFor(model => model.StartMileage)
                        </dd>
                        <dt class="col-sm-2">
                            @Html.DisplayNameFor(model => model.StartClock)
                        </dt>
                        <dd class="col-sm-10">
                            @Html.DisplayFor(model => model.StartClock)
                        </dd>
                        <dt class="col-sm-2">
                            @Html.DisplayNameFor(model => model.ContinuityGuaranty)
                        </dt>
                        <dd class="col-sm-10">
                            @Html.DisplayFor(model => model.ContinuityGuaranty)
                        </dd>
                        <dt class="col-sm-2">
                            @Html.DisplayNameFor(model => model.Reserved)
                        </dt>
                        <dd class="col-sm-10">
                            @Html.DisplayFor(model => model.Reserved)
                        </dd>
                        <dt class="col-sm-2">
                            @Html.DisplayNameFor(model => model.ChassisGuaranteeListWarrantyStatus)
                        </dt>
                        <dd class="col-sm-10">
                            @Html.DisplayFor(model => model.ChassisGuaranteeListWarrantyStatus)
                        </dd>
                        <dt class="col-sm-2">
                            @Html.DisplayNameFor(model => model.ShowInInvoice)
                        </dt>
                        <dd class="col-sm-10">
                            @Html.DisplayFor(model => model.ShowInInvoice)
                        </dd>
                    </dl>
                </div>
                <div>
                    <a asp-action="Index">Back to List</a>
                </div>

            }
            else if (!string.IsNullOrEmpty(Model.VinNumber))
            {
                <p class="alert alert-danger">گارانتی یافت نشد</p>
            } 
        </div>
    </div>
</div>


@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
