                        <dd class="col-sm-10">
                            @Html.DisplayFor(model => model.GuaranteeMileage)
                        </dd>
                        <dt class="col-sm-2">
                            @Html.DisplayNameFor(model => model.GuaranteeDuration)
                        </dt>
                        <dd class="col-sm-10">
                            @Html.DisplayFor(model => model.GuaranteeDuration)
                        </dd>
                        <dt class="col-sm-2">
