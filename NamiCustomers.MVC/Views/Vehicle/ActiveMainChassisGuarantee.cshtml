@if (Model.ChassisGuaranteeListWarrantyStatus == "Has Guarantee")
{
    <br />
    <div class="container">

        <div class="divider divider-center-icon mt-3">
            <i class="bi bi-gear"></i>
        </div>

    </div>
    <br />
    <div class="container">
        <div class="card comparison-table-one">
            <div class="card-body">
                <table class="table mb-0">
                    <thead class="thead-light">
                        <tr style="text-align:center">
                            <th colspan="2"> نتیجه استعلام گارانتی</th>


                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <th> @Html.DisplayNameFor(model => model.GuarantyTypeName)</th>
                            <td> @Html.DisplayFor(model => model.GuarantyTypeName)</td>

                        </tr>
                        <tr>
                            <th> @Html.DisplayNameFor(model => model.StrRegisterDateTime)</th>
                            <td> @Html.DisplayFor(model => model.StrRegisterDateTime)</td>

                        </tr>
                        <tr>
                            <th> @Html.DisplayNameFor(model => model.StrExpireDateTime)</th>
                            <td> @Html.DisplayFor(model => model.StrExpireDateTime)</td>

                        </tr>
                        <tr>
                            <th> @Html.DisplayNameFor(model => model.GuaranteeMileage)</th>
                            <td>@string.Format("{0:#,##0}", Model.GuaranteeMileage) کیلومتر</td>
                        </tr>
                        <tr>
                            <th> @Html.DisplayNameFor(model => model.GuaranteeDuration)</th>
                            <td> @Html.DisplayFor(model => model.GuaranteeDuration)  ماه</td>

                        </tr>
                        <tr>
                            <th> @Html.DisplayNameFor(model => model.ChassisGuaranteeListWarrantyStatus)</th>

                            @if (Model.ChassisGuaranteeListWarrantyStatus == "Has Guarantee")
                            {
                                <td><i class="text-success bi bi-check-lg fz-16"></i></td>
                            }
                            else
                            {

                                <td><i class="text-danger bi bi-x-lg"></i></td>

                            }


                        </tr>

                    </tbody>
                </table>
            </div>
        </div>
    </div>



}
else if (!string.IsNullOrEmpty(Model.VinNumber))
{
    <br />
    <div class="container">

        <div class="divider divider-center-icon mt-3">
            <i class="bi bi-gear"></i>
        </div>

    </div>
    <br />
    <div class="container">
        <div class="card comparison-table-one">
            <div class="card-body">
                <div class="alert custom-alert-one alert-danger alert-dismissible fade show" role="alert">
                    <i class="bi bi-x-circle"></i>
                    هیچ موردی یافت نشد!
                  @*   <button class="btn btn-close position-relative p-1 ms-auto" type="button" data-bs-dismiss="alert" aria-label="Close"></button> *@
                </div>
@*                 <table class="table mb-0">
