@using NamiCustomers.Abstractions.Dtos.Vehicles
@model ActiveMainChassisGuaranteeResponse
@{
    ViewData["Title"] = "ActiveMainChassisGuarantee";
}
<br />



<div class="container direction-rtl">
    <div class="card">
        <div class="card-body p-2">
            <div class="d-flex align-items-center justify-content-between">
                <small class="ms-1">استعلام</small>
                <form action="#">
                    <a asp-action="Index" title="بازگشت"> <i class="bi bi-arrow-left-short" style="font-size:2rem !important;line-height:1"></i></a>
                </form>
            </div>
        </div>
    </div>
</div>
<br />
<div class="container">
    <!-- User Meta Data-->
    <div class="card user-data-card">
        <div class="card-body">
            <form asp-action="ActiveMainChassisGuarantee" method="get">
                
                <div class="form-group mb-3">
                    
                    <label class="control-label" style="color: #fff !important;">شماره شاسی</label>
                    <input name="VinNumber" value="@Model.VinNumber" class="form-control" type="text" style="color: #000 !important;"   />
                     
                </div>
                <input type="submit" value="استعلام" class="btn btn-primary w-100" />
            </form>
            @if (Model.ChassisGuaranteeListWarrantyStatus == "Has Guarantee")
            {
                <div>
                    <h4>ActiveMainChassisGuaranteeResponse</h4>
                    <hr />
                    <dl class="row">
                        <dt class="col-sm-2">
                            @Html.DisplayNameFor(model => model.Code)
                        </dt>
                        <dd class="col-sm-10">
                            @Html.DisplayFor(model => model.Code)
                        </dd>
                        <dt class="col-sm-2">
                            @Html.DisplayNameFor(model => model.UniqueId)
                        </dt>
                        <dd class="col-sm-10">
                            @Html.DisplayFor(model => model.UniqueId)
                        </dd>
                        <dt class="col-sm-2">
                            @Html.DisplayNameFor(model => model.RegisterDateTime)
                        </dt>
                        <dd class="col-sm-10">
                            @Html.DisplayFor(model => model.RegisterDateTime)
                        </dd>
                        <dt class="col-sm-2">
                            @Html.DisplayNameFor(model => model.StrRegisterDateTime)
                        </dt>
                        <dd class="col-sm-10">
                            @Html.DisplayFor(model => model.StrRegisterDateTime)
                        </dd>
                        <dt class="col-sm-2">
                            @Html.DisplayNameFor(model => model.ExpireDateTime)
                        </dt>
                        <dd class="col-sm-10">
                            @Html.DisplayFor(model => model.ExpireDateTime)
                        </dd>
                        <dt class="col-sm-2">
                            @Html.DisplayNameFor(model => model.StrExpireDateTime)
                        </dt>
                        <dd class="col-sm-10">
                            @Html.DisplayFor(model => model.StrExpireDateTime)
                        </dd>
                        <dt class="col-sm-2">
                            @Html.DisplayNameFor(model => model.Active)
                        </dt>
                        <dd class="col-sm-10">
                            @Html.DisplayFor(model => model.Active)
                        </dd>
                        <dt class="col-sm-2">
                            @Html.DisplayNameFor(model => model.GuarantyTypeName)
                        </dt>
                        <dd class="col-sm-10">
                            @Html.DisplayFor(model => model.GuarantyTypeName)
                        </dd>
                        <dt class="col-sm-2">
                            @Html.DisplayNameFor(model => model.GuarantyGroupName)
                        </dt>
                        <dd class="col-sm-10">
                            @Html.DisplayFor(model => model.GuarantyGroupName)
                        </dd>
                        <dt class="col-sm-2">
                            @Html.DisplayNameFor(model => model.GuarantyTypeGroupId)
                        </dt>
                        <dd class="col-sm-10">
                            @Html.DisplayFor(model => model.GuarantyTypeGroupId)
                        </dd>
                        <dt class="col-sm-2">
                            @Html.DisplayNameFor(model => model.GuarantyTypeGroupName)
                        </dt>
                        <dd class="col-sm-10">
