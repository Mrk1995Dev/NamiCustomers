                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <th> هیچ موردی یافت نشد</th>
                           

                        </tr>
                       
                    </tbody>
                </table> *@
            </div>
        </div>
    </div>

}


@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
