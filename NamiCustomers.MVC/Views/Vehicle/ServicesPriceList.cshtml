@model  NamiCustomers.Infrastucture.ExternalServices.SevenSoft.Dtos.ServicesPriceResponse[]

@{
    ViewData["Title"] = "ServicesPriceList";
}

<br />

<div class="container direction-rtl">
    <div class="card">
        <div class="card-body p-2">
            <div class="d-flex align-items-center justify-content-between">
                <small class="ms-1">نمایش لیست قیمت </small>
                <form action="#">

                    <a title="بازگشت" href="/Vehicle/ServicesPrice"> <i class="bi bi-arrow-left-short" style="font-size:2rem !important;line-height:1"></i></a>

                </form>
            </div>
        </div>
    </div>
</div>
<hr />
@if(Model.Any())
{

    <div class="container">
        <div class="card">
            <div class="card-body">
                <table class="w-100" id="dataTable">
                    <thead>
                        <tr>
                            <th>  @Html.DisplayNameFor(model => model[0].RowNumber)</th>
                            <th> @Html.DisplayNameFor(model => model[0].ServiceCode)</th>
                            <th> @Html.DisplayNameFor(model => model[0].ServiceName)</th>

                            <th>
                                @Html.DisplayNameFor(model => model[0].PriceCustomer)
                            </th>
                            <th>
                                @Html.DisplayNameFor(model => model[0].PriceWarranty)
                            </th>
                          
                           
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    @Html.DisplayFor(modelItem => item.RowNumber)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.ServiceCode)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.ServiceName)
                                </td>
                             
                                @*   <td>
                        @Html.DisplayFor(modelItem => item.BranchId)
                    </td> *@
                                <td>
                                    @string.Format("{0:#,##0}", item.PriceCustomer)
                                   
                                </td>
                                <td>
                                    @string.Format("{0:#,##0}", item.PriceWarranty)
                                  
                                </td>

                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>


 

}

