@model KeyValuePair<string,List<string>>
@{
    ViewData["Title"] = "UserRoles";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

 
<a asp-action="Index"> @ViewBag.UserInfo</a>
<br />
<table class="table table-striped">
    <thead>
        <tr>
            <td>عنوان نقش </td>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Value)
        {
        <tr>
            <td>
                @item
            </td>

            <td>
                    @Html.ActionLink("حذف", "DeleteUserRole", "Users", new {userid=Model.Key, rolename = item, area = "Admin" })
            </td>
        </tr>
        }
    </tbody>
</table>

<div>
    <a asp-action="Index">Back to List</a>
</div>

