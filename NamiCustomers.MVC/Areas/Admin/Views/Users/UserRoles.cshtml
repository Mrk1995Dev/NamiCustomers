@model IList<string>
@{
    ViewData["Title"] = "UserRoles";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

 
<a asp-action="Index"> @ViewBag.UserInfo</a>
<br />
<table class="table table-striped">
    <thead>
        <tr>
            <td>عنوان نقش </td>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
        <tr>
            <td>
                @item
            </td>
        </tr>
        }
    </tbody>
</table>

